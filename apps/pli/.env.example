DATABASE_URL=postgres://pli:MOT_DE_PASSE@HOTE_POSTGRES:5432/pli
# permission.plbls.fr (réseau interne) et token de service « pli » déclaré chez permission
PERMISSION_URL=http://permission:8080
PERMISSION_SERVICE_TOKEN=
# Adresse publique du gateway, pour la connexion (défaut : https://security.plbls.fr)
#GATEWAY_URL=https://security.plbls.fr
# Adresse du gateway utilisée par le serveur pour /auth/me (défaut : GATEWAY_URL) ; réseau Docker possible
#GATEWAY_INTERNAL_URL=http://auth-gateway:8080
# Permission exigée pour déposer (défaut : pli:deposit)
#DEPOSIT_PERMISSION=pli:deposit
# Taille maximale du chiffré en octets (défaut : 26214400 = 25 Mo)
#MAX_BYTES=26214400
# Partages en attente par compte (défaut : 50)
#MAX_PENDING_PER_USER=50
