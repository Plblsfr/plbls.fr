meta {
  name: GET /auth/me (cookie)
  type: http
  seq: 1
}

get {
  url: {{gw}}/auth/me
  body: none
  auth: none
}

headers {
  Cookie: plbls_sid={{sid}}
}

tests {
  test("identité du cookie", function () {
    expect(res.status).to.equal(200);
    expect(res.body.name).to.equal("demo");
    expect(res.body.email).to.equal("demo@plbls.fr");
    expect(res.body.client).to.equal("plbls-gateway");
    expect(res.body.roles).to.include("user");
    expect(res.headers["cache-control"]).to.equal("no-store");
  });
}
