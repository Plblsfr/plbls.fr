meta {
  name: token tokShort (plbls-short/demo)
  type: http
  seq: 5
}

post {
  url: {{kc}}/realms/plbls/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: plbls-short
  username: demo
  password: demo
}

script:pre-request {
  req.setMaxRedirects(0);

}

script:post-response {
  bru.setVar("tokShort", res.body.access_token || "");
}

tests {
  test("token obtenu", function () { expect(res.status).to.equal(200); });
}
