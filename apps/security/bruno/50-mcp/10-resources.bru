meta {
  name: MCP resources/list + read
  type: http
  seq: 10
}

post {
  url: {{gw}}/mcp
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{mcpToken}}
  Content-Type: application/json
  Accept: application/json, text/event-stream
}

body:json {
  {"jsonrpc":"2.0","id":6,"method":"resources/list"}
}

script:pre-request {
  req.setMaxRedirects(0);

}

tests {
  test("9 docs", function () { expect(res.body.result.resources.length).to.equal(9); expect(res.body.result.resources[0].uri).to.match(/^plbls:\/\/docs\//); });
}
