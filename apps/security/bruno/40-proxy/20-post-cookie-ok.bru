meta {
  name: POST par cookie, Origin autorisé : 200 avec corps
  type: http
  seq: 20
}

post {
  url: {{gw}}/api/private/x
  body: json
  auth: none
}

headers {
  Cookie: plbls_sid={{sid}}
  Origin: http://localhost:3000
  Content-Type: application/json
}

body:json {
  {"a": "bcdef"}
}

script:pre-request {
  req.setMaxRedirects(0);

}

tests {
  test("corps relayé", function () { expect(res.status).to.equal(200); expect(res.body).to.contain("POST /x HTTP/1.1"); expect(res.body).to.contain("Content-Length: 14"); });
}
