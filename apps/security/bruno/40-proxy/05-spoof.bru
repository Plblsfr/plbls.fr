meta {
  name: en-têtes d'identité falsifiés écrasés
  type: http
  seq: 5
}

get {
  url: {{gw}}/api/private/x
  body: none
  auth: none
}

headers {
  Cookie: plbls_sid={{sid}}
  X-User-Id: hacker
  X-User-Roles: root
  X-User-Name: hacker
  X-Identity-Sig: forged
}

script:pre-request {
  req.setMaxRedirects(0);

}

tests {
  test("valeurs du client ignorées", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.not.contain("hacker");
    expect(res.body).to.not.contain("X-User-Roles: root");
    expect(res.body).to.contain("X-User-Name: demo");
  });
}
