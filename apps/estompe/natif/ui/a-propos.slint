import { AboutSlint } from "std-widgets.slint";
import { Theme, Typo, Espace } from "jetons.slint";
import { Interrupteur } from "composants/interrupteur.slint";
import { PanneauMiseAJour } from "mise-a-jour/panneau.slint";

export component APropos {
    in property <string> version;
    in property <bool> demarrage-disponible: false;
    in-out property <bool> demarrage-actif: false;
    in-out property <bool> notifications-bureau: true;
    callback demarrage-change(bool);
    callback notifications-change(bool);
    VerticalLayout {
        spacing: Espace.e3;
        alignment: start;
        HorizontalLayout {
            spacing: Espace.e3;
            alignment: start;
            Image {
                width: 56px;
                height: 56px;
                source: @image-url("../icones/estompe.png");
                accessible-role: none;
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: "Estompe natif (beta)";
                    color: Theme.encre;
                    font-family: Typo.titre;
                    font-size: Typo.titre-section;
                    font-weight: Typo.demi-gras;
                }
                Text {
                    text: "Version " + root.version;
                    color: Theme.gris;
                    font-family: Typo.mono;
                    font-size: Typo.petit;
                }
            }
        }
        Text {
            text: "Messagerie écrite et vocale, sans webview. Cette version est en beta tant qu'elle ne couvre pas toute l'app de bureau actuelle.";
            color: Theme.encre-2;
            font-family: Typo.texte;
            font-size: Typo.corps;
            wrap: word-wrap;
        }
        Text {
            text: "Polices Bricolage Grotesque, Instrument Sans et JetBrains Mono, sous licence SIL Open Font License 1.1.";
            color: Theme.gris;
            font-family: Typo.texte;
            font-size: Typo.petit;
            wrap: word-wrap;
        }
        Text {
            text: "Emoji : Twemoji, © Twitter, Inc. et autres contributeurs, sous licence CC-BY 4.0 (creativecommons.org/licenses/by/4.0) ; table des séquences : emoji-data de Cal Henderson, licence MIT.";
            color: Theme.gris;
            font-family: Typo.texte;
            font-size: Typo.petit;
            wrap: word-wrap;
        }
        Text {
            text: "Vidéos et messages vocaux : FFmpeg (ffmpeg.org), livré avec l'installeur Windows, sous licence LGPL version 3 ou ultérieure ; build et sources : github.com/BtbN/FFmpeg-Builds.";
            color: Theme.gris;
            font-family: Typo.texte;
            font-size: Typo.petit;
            wrap: word-wrap;
        }
        Text {
            text: "Bureau";
            color: Theme.encre;
            font-family: Typo.titre;
            font-size: Typo.corps;
            font-weight: Typo.demi-gras;
        }
        Interrupteur {
            texte: "Notifications du bureau";
            calque: 1;
            allume <=> root.notifications-bureau;
            bascule(actif) => {
                root.notifications-change(actif);
            }
        }
        if root.demarrage-disponible: Interrupteur {
            texte: "Lancer Estompe natif à l'ouverture de la session";
            calque: 1;
            allume <=> root.demarrage-actif;
            bascule(actif) => {
                root.demarrage-change(actif);
            }
        }
        PanneauMiseAJour { }
        Rectangle {
            height: 128px;
            border-radius: 10px;
            background: Theme.sombre ? #f7f3ee : transparent;
            AboutSlint {
                height: 108px;
            }
        }
    }
}
