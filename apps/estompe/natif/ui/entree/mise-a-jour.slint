import { Theme, Typo, Rayon, Espace } from "../jetons.slint";
import { Icone, Bouton, VarianteBouton } from "../composants.slint";
import { FondAcces, Carte, AGauche, TitreCarte, TexteCarte, Note } from "commun.slint";
import { DonneesMiseAJour, BarreProgression } from "../mise-a-jour/donnees.slint";

export component MiseAJour inherits Rectangle {
    in property <string> version;
    in property <string> version-minimale;
    in property <string> message;
    callback telecharger();
    callback ouvrir-page();
    property <bool> automatique: DonneesMiseAJour.automatique;
    accessible-role: none;
    FondAcces {
        Carte {
            AGauche {
                Rectangle {
                    height: 20px;
                    width: etiquette.preferred-width + 14px;
                    border-radius: Rayon.xs;
                    background: Theme.attention-fond;
                    etiquette := HorizontalLayout {
                        alignment: center;
                        spacing: Espace.e1;
                        VerticalLayout {
                            alignment: center;
                            Icone {
                                nom: "alerte";
                                taille: 12px;
                                couleur: Theme.attention;
                            }
                        }
                        Text {
                            text: "Obligatoire";
                            color: Theme.attention;
                            font-size: 11px;
                            font-weight: Typo.demi-gras;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            TitreCarte {
                text: "Mise à jour requise";
                font-size: 22px;
            }
            TexteCarte {
                text: "Cette version d'Estompe ne peut plus être utilisée.";
            }
            HorizontalLayout {
                spacing: Espace.e6;
                VerticalLayout {
                    spacing: 2px;
                    Note {
                        text: "Installée";
                    }
                    Text {
                        text: root.version;
                        color: Theme.encre;
                        font-family: Typo.mono;
                        font-size: Typo.petit;
                    }
                }
                if root.version-minimale != "": VerticalLayout {
                    spacing: 2px;
                    Note {
                        text: "Minimale";
                    }
                    Text {
                        text: root.version-minimale;
                        color: Theme.encre;
                        font-family: Typo.mono;
                        font-size: Typo.petit;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            if root.message != "": TexteCarte {
                text: root.message;
                font-size: Typo.compact;
            }
            Rectangle {
                height: 1px;
                background: Theme.trait;
            }
            if root.automatique && DonneesMiseAJour.en-cours: VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    Note {
                        text: DonneesMiseAJour.installation || DonneesMiseAJour.progression <= 0 ? "Installation" : "Téléchargement";
                        horizontal-stretch: 1;
                    }
                    if !DonneesMiseAJour.installation && DonneesMiseAJour.progression > 0: Text {
                        text: DonneesMiseAJour.pourcentage();
                        color: Theme.encre;
                        font-family: Typo.mono;
                        font-size: Typo.petit;
                    }
                }
                BarreProgression {
                    valeur: DonneesMiseAJour.installation ? 1 : DonneesMiseAJour.progression;
                    couleur: Theme.rose-fonce;
                    description: "Téléchargement de la mise à jour";
                }
            }
            if root.automatique && DonneesMiseAJour.erreur != "": Rectangle {
                border-radius: Rayon.s;
                background: Theme.danger-fond;
                height: erreur.preferred-height + 2 * Espace.e3;
                erreur := Text {
                    x: Espace.e3;
                    width: parent.width - 2 * Espace.e3;
                    text: DonneesMiseAJour.erreur;
                    color: Theme.danger;
                    font-size: Typo.petit;
                    wrap: word-wrap;
                    accessible-role: text;
                }
            }
            Bouton {
                texte: !root.automatique ? "Télécharger la mise à jour" : DonneesMiseAJour.erreur != "" ? "Réessayer" : DonneesMiseAJour.en-cours ? DonneesMiseAJour.libelle-progression() : "Installer la mise à jour";
                icone: "telecharge";
                variante: VarianteBouton.primaire;
                en-cours: root.automatique && DonneesMiseAJour.en-cours;
                clique => {
                    root.telecharger();
                }
            }
            if root.automatique && DonneesMiseAJour.erreur != "": Bouton {
                texte: "Ouvrir la page de téléchargement";
                variante: VarianteBouton.secondaire;
                clique => {
                    root.ouvrir-page();
                }
            }
            Note {
                text: root.automatique ? "La nouvelle version s'installe en arrière-plan, puis Estompe natif redémarre et ta session reprend." : "La page de téléchargement s'ouvre dans ton navigateur. Installe la nouvelle version, puis relance Estompe.";
            }
        }
    }
}
