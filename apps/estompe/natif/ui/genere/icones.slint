export global Icones {
    out property <[string]> noms: ["actualise", "agrandir", "alerte", "annule", "arobase", "bas", "boite", "bouclier", "bug", "bulle", "cadenas", "calendar", "calque", "cam", "camera-off", "casque", "casqueoff", "cherche", "cible", "ciseaux", "clap", "cle", "cloche", "coeur", "coeurplein", "commande", "copie", "corbeille", "couronne", "crayon", "curseurs", "diffuser", "down", "drapeau", "droite", "ecran", "envoi", "envoie", "epingle", "etincelle", "etoile", "expand", "external", "fil", "file", "file-attente", "film", "filtre", "flamme", "gauche", "gens", "gif", "globe", "gomme", "grid", "hash", "histoire", "horloge", "image", "info", "interdit", "interro", "lecture", "lien", "list", "lune", "mail", "main", "maison", "medaille", "menu", "mic", "micoff", "minus", "mobile", "note", "oeil", "ok", "onde", "panneau", "pause", "perso", "phone", "pinceau", "pip", "plus", "plus3", "poignee", "precedent", "raccroche", "recadre", "reduire", "reglages", "repeat", "replay", "repondre", "retablis", "sablier", "scene", "shuffle", "soleil", "sondage", "sortie", "sourire", "suivant", "tele", "telecharge", "trombone", "trophee", "video", "vol", "volcoupe", "volmax", "x"];
    pure public function cle(nom: string) -> string {
        if (nom == "chevron") { return "droite"; }
        if (nom == "more") { return "plus3"; }
        if (nom == "flag") { return "drapeau"; }
        if (nom == "check") { return "ok"; }
        if (nom == "sliders") { return "curseurs"; }
        if (nom == "volume") { return "vol"; }
        if (nom == "search") { return "cherche"; }
        if (nom == "pin") { return "epingle"; }
        if (nom == "users") { return "gens"; }
        if (nom == "reply") { return "repondre"; }
        if (nom == "edit") { return "crayon"; }
        if (nom == "trash") { return "corbeille"; }
        if (nom == "play") { return "lecture"; }
        if (nom == "lock") { return "cadenas"; }
        if (nom == "focus") { return "agrandir"; }
        if (nom == "minimize") { return "reduire"; }
        if (nom == "mic-off") { return "micoff"; }
        if (nom == "headphones") { return "casque"; }
        if (nom == "headphones-off") { return "casqueoff"; }
        if (nom == "camera") { return "cam"; }
        if (nom == "monitor") { return "ecran"; }
        if (nom == "eye") { return "oeil"; }
        if (nom == "clip") { return "trombone"; }
        if (nom == "smile") { return "sourire"; }
        if (nom == "up") { return "envoi"; }
        if (nom == "phone-off") { return "raccroche"; }
        if (nom == "chart") { return "sondage"; }
        if (nom == "next") { return "suivant"; }
        if (nom == "restart") { return "precedent"; }
        return nom;
    }
