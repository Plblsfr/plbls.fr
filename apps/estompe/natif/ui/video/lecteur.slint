import { Theme, Typo, Rayon, Espace, Calques } from "../jetons.slint";
import { Icone } from "../composants/icone.slint";
import { LecteurMedia, EtatLecteurVue } from "../composants/lecteur.slint";

export { EtatLecteurVue }

export global DonneesLecteur {
    in property <bool> ouvert: false;
    in property <string> titre;
    in property <string> piece;
    in property <bool> telechargeable: false;
    in property <EtatLecteurVue> etat;
    in property <float> avance: 0;
    callback basculer();
    callback aller(float);
    callback volume(int);
    callback muet();
    callback plein-ecran();
    callback menu-vitesse(length, length);
    callback menu-audio(length, length);
    callback menu-sous-titres(length, length);
    callback touche(string, bool, bool, bool) -> bool;
    callback zone-image(length, length);
    callback fermer();
    callback telecharger();
}

component BoutonPlein inherits Rectangle {
    in property <string> icone;
    in property <string> description;
    callback clique();
    width: 40px;
    height: 40px;
    border-radius: Rayon.s;
    background: zone.has-hover ? #ffffff24 : #0e0c0b99;
    accessible-role: button;
    accessible-label: root.description;
    accessible-action-default => {
        root.clique();
    }
    Icone {
        nom: root.icone;
        taille: 20px;
        couleur: #f1ece6;
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clique();
        }
    }
}

export component LecteurPlein {
    in property <bool> ouvert: DonneesLecteur.ouvert;
    property <int> niveau: 1;
    width: 100%;
    height: 100%;
    visible: root.ouvert;
    accessible-role: none;
    changed ouvert => {
        Calques.ouverts = Math.max(0, Calques.ouverts + (root.ouvert ? 1 : -1));
        if (root.ouvert) {
            root.niveau = Calques.ouverts;
            DonneesLecteur.zone-image(lecteur.width, lecteur.height);
            lecteur.focus-lecteur();
        }
    }
    Rectangle {
        background: #0e0c0b;
        TouchArea { }
    }
    FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                DonneesLecteur.fermer();
                return accept;
            }
            return reject;
        }
        lecteur := LecteurMedia {
            width: 100%;
            height: 100%;
            etat: DonneesLecteur.etat;
            avance: DonneesLecteur.avance;
            titre: DonneesLecteur.titre;
            calque: root.niveau;
            basculer => {
                DonneesLecteur.basculer();
            }
            aller(v) => {
                DonneesLecteur.aller(v);
            }
            volume(v) => {
                DonneesLecteur.volume(v);
            }
            muet => {
                DonneesLecteur.muet();
            }
            plein-ecran => {
                DonneesLecteur.plein-ecran();
            }
            menu-vitesse(x, y) => {
                DonneesLecteur.menu-vitesse(x, y);
            }
            menu-audio(x, y) => {
                DonneesLecteur.menu-audio(x, y);
            }
            menu-sous-titres(x, y) => {
                DonneesLecteur.menu-sous-titres(x, y);
            }
            touche(t, c, m, a) => {
                return DonneesLecteur.touche(t, c, m, a);
            }
            zone-image(l, h) => {
                if (root.ouvert) {
                    DonneesLecteur.zone-image(l, h);
                }
            }
        }
    }
    if root.ouvert: HorizontalLayout {
        x: Espace.e3;
        y: Espace.e3;
        width: parent.width - 2 * Espace.e3;
        height: 40px;
        spacing: Espace.e2;
        BoutonPlein {
            icone: "x";
            description: "Fermer le lecteur";
            clique => {
                DonneesLecteur.fermer();
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            Text {
                x: 0;
                width: Math.min(parent.width, self.preferred-width);
                height: parent.height;
                text: DonneesLecteur.titre;
                color: #f1ece6;
                font-family: Typo.texte;
                font-size: Typo.compact;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: text;
            }
        }
        if DonneesLecteur.telechargeable: BoutonPlein {
            icone: "telecharge";
            description: "Télécharger";
            clique => {
                DonneesLecteur.telecharger();
            }
        }
    }
}
