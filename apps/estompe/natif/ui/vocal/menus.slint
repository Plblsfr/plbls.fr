import { Theme, Typo, Rayon, Espace, Calques } from "../jetons.slint";
import { Bouton, VarianteBouton, Modal, Interrupteur, Curseur, Icone } from "../composants.slint";
import { DonneesVocal, ListePeripheriques } from "donnees.slint";

export component MenuParticipant inherits Modal {
    titre: DonneesVocal.menu.nom;
    ouvert: DonneesVocal.menu-ouvert;
    largeur: 420px;
    ferme => {
        DonneesVocal.menu-ouvert = false;
    }
    if DonneesVocal.menu-ouvert: VerticalLayout {
        spacing: Espace.e4;
        if DonneesVocal.menu.partage && !DonneesVocal.menu.son-partage: Text {
            text: "Ce partage n'a pas de son.";
            color: Theme.gris;
            font-size: Typo.petit;
        }
        if !DonneesVocal.menu.partage || DonneesVocal.menu.son-partage: Interrupteur {
            texte: DonneesVocal.menu.partage ? "Couper le son du partage" : "Muet pour moi";
            allume: DonneesVocal.menu.muet;
            calque: 1;
            bascule(muet) => {
                DonneesVocal.muet-pour-moi(muet);
            }
        }
        if !DonneesVocal.menu.partage || DonneesVocal.menu.son-partage: VerticalLayout {
            spacing: Espace.e1;
            HorizontalLayout {
                Text {
                    horizontal-stretch: 1;
                    text: DonneesVocal.menu.partage ? "Volume du partage" : "Volume";
                    color: Theme.encre-2;
                    font-size: Typo.petit;
                }
                Text {
                    text: "\{Math.round(volume.valeur)} %";
                    color: Theme.encre-2;
                    font-family: Typo.mono;
                    font-size: Typo.petit;
                }
            }
            volume := Curseur {
                libelle: "Volume de \{DonneesVocal.menu.nom}";
                unite: " %";
                minimum: 0;
                maximum: 300;
                pas: 5;
                valeur: DonneesVocal.menu.volume;
                calque: 1;
                change(v) => {
                    DonneesVocal.volume(Math.round(v), false);
                }
                fini(v) => {
                    DonneesVocal.volume(Math.round(v), true);
                }
            }
        }
        if DonneesVocal.menu.partage: VerticalLayout {
            spacing: Espace.e1;
            Text {
                text: "Qualité reçue";
                color: Theme.encre-2;
                font-size: Typo.petit;
            }
            HorizontalLayout {
                spacing: Espace.e1;
                alignment: start;
                for q[i] in DonneesVocal.menu.qualites: Bouton {
                    texte: q;
                    icone: i == DonneesVocal.menu.qualite ? "check" : "";
                    variante: i == DonneesVocal.menu.qualite ? VarianteBouton.secondaire : VarianteBouton.fantome;
                    calque: 1;
                    clique => {
                        DonneesVocal.choisir-qualite-recue(i);
                    }
                }
            }
            Text {
                text: DonneesVocal.menu.qualite == 0 ? "Adaptée à la taille de l'image et à ta connexion." : "Plafonnée par la qualité envoyée et par ta connexion.";
                color: Theme.gris;
                font-size: Typo.petit;
                wrap: word-wrap;
            }
        }
        if DonneesVocal.menu.partage: VerticalLayout {
            spacing: Espace.e1;
            Text {
                text: DonneesVocal.menu.spectateurs.length == 0 ? "Aucun spectateur" : DonneesVocal.menu.spectateurs.length == 1 ? "1 spectateur" : "\{DonneesVocal.menu.spectateurs.length} spectateurs";
                color: Theme.encre-2;
                font-size: Typo.petit;
            }
            for nom in DonneesVocal.menu.spectateurs: HorizontalLayout {
                spacing: Espace.e2;
                VerticalLayout {
                    alignment: center;
                    Icone {
                        nom: "oeil";
                        taille: 14px;
                        couleur: Theme.gris;
                    }
                }
                Text {
                    text: nom;
                    color: Theme.encre;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        if DonneesVocal.menu.partage: Bouton {
            texte: "Arrêter de regarder";
            icone: "oeil";
            calque: 1;
            clique => {
                DonneesVocal.regarder(DonneesVocal.menu.utilisateur, false);
            }
        }
        if DonneesVocal.menu.peut-couper-micro || DonneesVocal.menu.peut-couper-son: VerticalLayout {
            spacing: Espace.e2;
            if DonneesVocal.menu.peut-couper-micro: Bouton {
                texte: DonneesVocal.menu.micro-impose ? "Rétablir le micro du serveur" : "Couper le micro du serveur";
                icone: "mic-off";
                calque: 1;
                clique => {
                    DonneesVocal.moderer(!DonneesVocal.menu.micro-impose, DonneesVocal.menu.son-impose);
                }
            }
            if DonneesVocal.menu.peut-couper-son: Bouton {
                texte: DonneesVocal.menu.son-impose ? "Rétablir le son du serveur" : "Couper le son du serveur";
                icone: "headphones-off";
                calque: 1;
                clique => {
                    DonneesVocal.moderer(DonneesVocal.menu.micro-impose, !DonneesVocal.menu.son-impose);
                }
            }
        }
        if DonneesVocal.menu.destinations.length > 0 || DonneesVocal.menu.peut-deconnecter: VerticalLayout {
            spacing: Espace.e2;
            for d in DonneesVocal.menu.destinations: Bouton {
                texte: "Déplacer vers « \{d.nom} »";
                icone: "droite";
                calque: 1;
                clique => {
                    DonneesVocal.deplacer(d.id);
                }
            }
            if DonneesVocal.menu.peut-deconnecter: Bouton {
                texte: "Déconnecter du vocal";
                icone: "raccroche";
                variante: VarianteBouton.danger;
                calque: 1;
                clique => {
                    DonneesVocal.deconnecter();
                }
            }
        }
        if DonneesVocal.menu.erreur != "": Text {
            text: DonneesVocal.menu.erreur;
            color: Theme.danger;
            font-size: Typo.petit;
            wrap: word-wrap;
            accessible-role: text;
        }
    }
}

export component ListePeripheriquesVocal inherits Modal {
    titre: DonneesVocal.liste == ListePeripheriques.micros ? "Choisir le micro" : "Choisir la sortie audio";
    ouvert: DonneesVocal.liste != ListePeripheriques.aucune;
    largeur: 420px;
    ferme => {
        DonneesVocal.liste = ListePeripheriques.aucune;
    }
    VerticalLayout {
        spacing: Espace.e1;
        for d in DonneesVocal.liste == ListePeripheriques.micros ? DonneesVocal.micros : DonneesVocal.sorties: Bouton {
            texte: d.nom;
            icone: d.choisi ? "check" : "";
            variante: d.choisi ? VarianteBouton.secondaire : VarianteBouton.fantome;
            calque: 1;
            clique => {
                DonneesVocal.choisir-peripherique(d.id);
            }
        }
    }
    Bouton {
        texte: DonneesVocal.liste == ListePeripheriques.micros ? "Seuil de voix et réglages audio…" : "Réglages audio…";
        icone: "sliders";
        variante: VarianteBouton.fantome;
        calque: 1;
        clique => {
            DonneesVocal.liste = ListePeripheriques.aucune;
            DonneesVocal.ouvrir-reglages();
        }
    }
}
