import { Theme, Typo, Rayon, Espace, Mouvement, Courbes, Calques } from "../jetons.slint";
import { Avatar } from "../composants.slint";
import { Anneau } from "../composants/focus.slint";
import { DonneesVocal, ParticipantVocal } from "donnees.slint";
import { BarresQualite, Onde, EtatsParticipant } from "commun.slint";
import { ImageFlux } from "../video/flux.slint";

export component Tuile inherits Rectangle {
    in property <ParticipantVocal> p;
    property <bool> utilisable: !p.moi && Calques.ouverts == 0;
    property <length> cote: Math.clamp(Math.min(self.width, self.height) * 0.3, 32px, 128px);
    border-radius: Rayon.l;
    background: video.pret ? #0e0c0b : Theme.papier-3;
    clip: true;
    accessible-role: button;
    accessible-label: root.p.nom + (root.p.moi ? " (toi)" : "") + (video.pret ? ", " + root.p.libelle-video : "");
    accessible-description: (root.p.parle ? "parle" : root.p.sourd ? "sourdine casque" : root.p.muet ? "micro coupé" : "") + (root.p.micro-impose ? ", micro coupé par un modérateur" : "") + (root.p.son-impose ? ", son coupé par un modérateur" : "");
    accessible-enabled: utilisable;
    accessible-action-default => {
        if (root.utilisable) {
            DonneesVocal.ouvrir-menu(root.p.utilisateur, root.p.salon);
        }
    }
    forward-focus: portee;
    video := ImageFlux {
        width: 100%;
        height: 100%;
        indice: root.p.video;
        visible: self.pret;
        rayon: Rayon.l;
        coins: Theme.papier;
    }
    if !video.pret: Avatar {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 - 8px;
        nom: root.p.nom;
        initiales: root.p.initiales;
        portrait: root.p.portrait;
        teinte: root.p.teinte;
        taille: root.cote;
        fond: Theme.papier-3;
    }
    if root.p.parle: Rectangle {
        border-radius: Rayon.l;
        border-width: 3px;
        border-color: Theme.voix;
    }
    pastille := Rectangle {
        x: 10px;
        y: parent.height - self.height - 10px;
        width: Math.min(meta.preferred-width, parent.width - 20px);
        height: 28px;
        border-radius: Rayon.pilule;
        background: Theme.surface.with-alpha(0.88);
        border-width: 1px;
        border-color: Theme.trait;
        meta := HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 6px;
            if root.p.parle: VerticalLayout {
                alignment: center;
                Onde { }
            }
            Text {
                text: root.p.nom + (root.p.moi ? " (toi)" : "") + (video.pret ? " · " + root.p.libelle-video : "");
                color: Theme.encre;
                font-size: Typo.petit;
                font-weight: Typo.demi-gras;
                vertical-alignment: center;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                EtatsParticipant {
                    muet: root.p.muet;
                    sourd: root.p.sourd;
                    micro-impose: root.p.micro-impose;
                    son-impose: root.p.son-impose;
                }
            }
            VerticalLayout {
                alignment: center;
                BarresQualite {
                    barres: root.p.barres;
                    libelle: root.p.qualite;
                }
            }
        }
    }
    Anneau {
        rayon: Rayon.l;
        width: parent.width + 8px;
        height: parent.height + 8px;
        actif: portee.has-focus && portee.clavier;
    }
    portee := FocusScope {
        property <bool> clavier: false;
        enabled: root.utilisable;
        focus-on-click: false;
        focus-gained(raison) => {
            self.clavier = raison != FocusReason.pointer-click;
        }
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") {
                DonneesVocal.ouvrir-menu(root.p.utilisateur, root.p.salon);
                return accept;
            }
            return reject;
        }
        TouchArea {
            enabled: root.utilisable;
            mouse-cursor: root.utilisable ? pointer : default;
            clicked => {
                DonneesVocal.ouvrir-menu(root.p.utilisateur, root.p.salon);
            }
        }
    }
}

export component LigneParticipant inherits Rectangle {
    in property <ParticipantVocal> p;
    property <bool> utilisable: !p.moi && Calques.ouverts == 0;
    property <bool> glisse-en-cours: glisse.dragging;
    changed glisse-en-cours => {
        if (self.glisse-en-cours) {
            DonneesVocal.glisse-depuis = root.p.salon;
        } else if (DonneesVocal.glisse-depuis == root.p.salon) {
            DonneesVocal.glisse-depuis = "";
        }
    }
    opacity: glisse.dragging ? 0.5 : 1;
    border-radius: Rayon.xs;
    background: zone.has-hover && root.utilisable ? Theme.papier-3 : transparent;
    accessible-role: button;
    accessible-label: root.p.nom;
    accessible-description: (root.p.parle ? "parle" : root.p.sourd ? "sourdine casque" : root.p.muet ? "micro coupé" : "") + (root.p.micro-impose ? ", micro coupé par un modérateur" : "") + (root.p.son-impose ? ", son coupé par un modérateur" : "");
    accessible-enabled: utilisable;
    accessible-action-default => {
        if (root.utilisable) {
            DonneesVocal.ouvrir-menu(root.p.utilisateur, root.p.salon);
        }
    }
    forward-focus: portee;
    HorizontalLayout {
        padding-left: 30px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Avatar {
                nom: root.p.nom;
                initiales: root.p.initiales;
                portrait: root.p.portrait;
                teinte: root.p.teinte;
                taille: 22px;
                parle: root.p.parle;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.p.nom;
            color: root.p.parle ? Theme.encre : Theme.encre-2;
            font-size: Typo.petit;
            font-weight: root.p.parle ? Typo.demi-gras : Typo.normal;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            EtatsParticipant {
                muet: root.p.muet;
                sourd: root.p.sourd;
                micro-impose: root.p.micro-impose;
                son-impose: root.p.son-impose;
            }
        }
    }
    Anneau {
        rayon: Rayon.xs;
        width: parent.width + 8px;
        height: parent.height + 8px;
        actif: portee.has-focus && portee.clavier;
    }
    portee := FocusScope {
        property <bool> clavier: false;
        enabled: root.utilisable;
        focus-on-click: false;
        focus-gained(raison) => {
            self.clavier = raison != FocusReason.pointer-click;
        }
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") {
                DonneesVocal.ouvrir-menu(root.p.utilisateur, root.p.salon);
                return accept;
            }
            return reject;
        }
        glisse := DragArea {
            enabled: root.utilisable && root.p.deplacable;
            allow-move: true;
            data: DonneesVocal.donnees-glisse(root.p.salon, root.p.utilisateur);
            zone := TouchArea {
                enabled: root.utilisable;
                mouse-cursor: !root.utilisable ? default : root.p.deplacable ? MouseCursor.grab : pointer;
                clicked => {
                    DonneesVocal.ouvrir-menu(root.p.utilisateur, root.p.salon);
                }
            }
        }
    }
}
