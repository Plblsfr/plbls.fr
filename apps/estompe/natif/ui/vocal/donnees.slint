export struct ParticipantVocal {
    salon: string,
    utilisateur: string,
    nom: string,
    initiales: string,
    teinte: int,
    moi: bool,
    parle: bool,
    muet: bool,
    sourd: bool,
    micro-impose: bool,
    son-impose: bool,
    barres: int,
    qualite: string,
    portrait: image,
    deplacable: bool,
    video: int,
    libelle-video: string,
    cle: string,
    partage: bool,
    regarde: bool,
    vedette: bool,
    rang: int,
    spectateurs: string,
    noms-spectateurs: string,
    son-partage: bool,
}

export struct VueVocal {
    salon: string,
    nom: string,
    cinema: bool,
    ici: bool,
    connexion: bool,
    reconnexion: bool,
    peut-rejoindre: bool,
    erreur: string,
    compte: string,
    resume: string,
    seul: bool,
    colonnes: int,
    rangees: int,
    vedette: bool,
    bande: int,
    plein-ecran: string,
}

export struct BarreVocal {
    visible: bool,
    connexion: bool,
    reconnexion: bool,
    titre: string,
    salon: string,
    serveur: string,
    lieu: string,
    duree: string,
    barres: int,
    qualite: string,
    micro-coupe: bool,
    casque-coupe: bool,
    micro-impose: bool,
    son-impose: bool,
    peut-parler: bool,
    message: string,
    camera-active: bool,
    camera-demarrage: bool,
    partage: bool,
    partage-demarrage: bool,
    partage-source: string,
    spectateurs-partage: string,
}

export struct OptionPartage {
    libelle: string,
    indice: string,
    choisi: bool,
    actif: bool,
}

export struct SourcePartageVocal {
    id: string,
    nom: string,
    detail: string,
    miniature: image,
    prete: bool,
}

export enum EtapePartage { source, apercu, qualite }

export struct IncrustationVocal {
    active: bool,
    coin: int,
    taille: float,
    marge: float,
    cercle: bool,
    bordure: bool,
    ombre: bool,
    miroir: bool,
    camera: bool,
}

export struct ChoixPartageVocal {
    ouvert: bool,
    etape: EtapePartage,
    fenetres: bool,
    chargement: bool,
    erreur: string,
    indisponible: bool,
    vide: string,
    source: string,
    detail: string,
    apercu: int,
    prereglages: [OptionPartage],
    resolutions: [OptionPartage],
    cadences: [OptionPartage],
    fluidite: bool,
    auto: bool,
    resume: string,
    changer: bool,
    son-disponible: bool,
    son: bool,
    libelle-son: string,
    incrustation: IncrustationVocal,
}

export struct ChoixCameraVocal {
    ouvert: bool,
    choisie: string,
    apercu: int,
    erreur: string,
    qualites: [string],
    qualite: int,
    debit: string,
}

export struct SalonDestination {
    id: string,
    nom: string,
}

export struct MenuVocal {
    utilisateur: string,
    nom: string,
    muet: bool,
    volume: int,
    peut-couper-micro: bool,
    peut-couper-son: bool,
    micro-impose: bool,
    son-impose: bool,
    destinations: [SalonDestination],
    peut-deconnecter: bool,
    erreur: string,
    partage: bool,
    son-partage: bool,
    spectateurs: [string],
    qualites: [string],
    qualite: int,
}

export struct PeripheriqueVocal {
    id: string,
    nom: string,
    choisi: bool,
}

export enum ListePeripheriques { aucune, micros, sorties }

export struct ReglagesVocal {
    bruit: int,
    gain: int,
    detection: bool,
    seuil: int,
    general: int,
    sons: bool,
    ptt: bool,
    touche: string,
    delai: int,
    ptt-message: string,
    ptt-global: bool,
    son-arrivee: int,
    son-depart: int,
    volume-sons: int,
    perso-arrivee: bool,
    perso-depart: bool,
}

export global DonneesVocal {
    in property <[ParticipantVocal]> tuiles;
    in property <[ParticipantVocal]> participants;
    in property <VueVocal> vue;
    in property <BarreVocal> barre;
    in property <float> niveau: 0;
    in property <bool> voix: false;
    in property <bool> parle-micro-coupe: false;
    in property <bool> ptt: false;
    in property <string> touche-ptt;
    in property <bool> ptt-parle: false;
    in-out property <bool> menu-ouvert: false;
    in property <MenuVocal> menu;
    in-out property <bool> menu-au-pointeur: false;
    in-out property <length> menu-x;
    in-out property <length> menu-y;
    in-out property <ListePeripheriques> liste: ListePeripheriques.aucune;
    in property <[PeripheriqueVocal]> micros;
    in property <[PeripheriqueVocal]> sorties;
    in-out property <bool> reglages-ouverts: false;
    in-out property <length> reglages-decalage: 0;
    in property <ReglagesVocal> reglages;
    in property <bool> essai: false;
    in-out property <bool> capture-touche: false;
    in property <string> capture-erreur;
    in property <bool> plein-cadre: false;
    in property <string> son-erreur;
    in-out property <string> glisse-depuis;
    in property <string> erreur-depot-salon;
    in property <string> erreur-depot;
    in property <ChoixCameraVocal> camera;
    in property <[PeripheriqueVocal]> cameras;
    in property <ChoixPartageVocal> partage;
    in property <[SourcePartageVocal]> sources-partage;
    callback rejoindre(string);
    callback ouvrir-vocal(string);
    callback quitter();
    callback basculer-micro();
    callback basculer-casque();
    callback ouvrir-liste(ListePeripheriques);
    callback choisir-peripherique(string);
    callback choisir-micro-depuis-reglages(string);
    callback choisir-sortie-depuis-reglages(string);
    callback ouvrir-menu(string, string);
    callback ouvrir-menu-partage(string);
    callback regarder(string, bool);
    callback epingler(string);
    callback plein-ecran(string);
    callback choisir-qualite-recue(int);
    public function ouvrir-menu-a(utilisateur: string, salon: string, au-pointeur: bool, x: length, y: length) {
        menu-au-pointeur = au-pointeur;
        menu-x = x;
        menu-y = y;
        ouvrir-menu(utilisateur, salon);
    }
    public function ouvrir-menu-partage-a(utilisateur: string, au-pointeur: bool, x: length, y: length) {
        menu-au-pointeur = au-pointeur;
        menu-x = x;
        menu-y = y;
        ouvrir-menu-partage(utilisateur);
    }
    callback muet-pour-moi(bool);
    callback volume(int, bool);
    callback moderer(bool, bool);
    callback deplacer(string);
    callback deconnecter();
    callback basculer-plein-cadre(bool);
    callback choisir-son(bool, int);
    callback volume-sons(int, bool);
    callback ecouter-son(bool);
    callback choisir-fichier-son(bool);
    pure callback donnees-glisse(string, string) -> data-transfer;
    pure callback peut-deposer(data-transfer, string) -> bool;
    callback deposer(data-transfer, string);
    callback basculer-camera();
    callback fermer-camera();
    callback choisir-camera(string);
    callback choisir-qualite-camera(int);
    callback activer-camera();
    callback rejoindre-avec-camera(string);
    callback ouvrir-partage();
    callback fermer-partage();
    callback onglet-partage(bool);
    callback actualiser-partage();
    callback choisir-source(string);
    callback revenir-aux-sources();
    callback prereglage-partage(int);
    callback resolution-partage(int);
    callback cadence-partage(int);
    callback fluidite-partage(bool);
    callback auto-partage(bool);
    callback son-partage(bool);
    callback partager();
    callback arreter-partage();
    callback qualite-partage();
    callback changer-source-partage();
    callback incrustation-active(bool);
    callback coin-incrustation(int);
    callback taille-incrustation(float, bool);
    callback marge-incrustation(float, bool);
    callback forme-incrustation(bool);
    callback option-incrustation(int, bool);
    callback deplacer-incrustation(float, float, bool);
    callback ouvrir-reglages();
    callback fermer-reglages();
    callback regler(ReglagesVocal, bool);
    callback essai-micro(bool);
    callback touche(string, bool) -> bool;
    callback touche-choisie(string) -> bool;
}
