import { Theme, Typo, Rayon } from "../jetons.slint";

export component Etiquette inherits Rectangle {
    in property <string> texte;
    height: 18px;
    width: libelle.preferred-width + 12px;
    border-radius: Rayon.pilule;
    background: Theme.papier-3;
    accessible-role: none;
    libelle := Text {
        text: root.texte;
        color: Theme.gris;
        font-family: Typo.mono;
        font-size: 10px;
        font-weight: Typo.moyen;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
