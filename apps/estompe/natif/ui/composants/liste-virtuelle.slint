import { Theme, Mouvement, Courbes } from "../jetons.slint";

component ListView {
    out property <length> visible-width <=> zone.width;
    out property <length> visible-height <=> zone.height;
    in-out property <length> content-width <=> zone.content-width;
    in-out property <length> content-height <=> zone.content-height;
    in-out property <length> content-x <=> zone.content-x;
    in-out property <length> content-y <=> zone.content-y;
    property <bool> utile: zone.content-height > zone.height;
    property <bool> montree: utile && (survol.has-hover || poignee-zone.pressed || poignee-zone.has-hover);
    preferred-height: 100%;
    preferred-width: 100%;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    accessible-role: list;
    survol := TouchArea {
        mouse-cursor: default;
    }
    zone := Flickable {
        width: 100%;
        height: 100%;
        @children
    }
    Rectangle {
        visible: root.utile;
        x: parent.width - 10px;
        y: 2px;
        width: 8px;
        height: parent.height - 4px;
        poignee := Rectangle {
            property <length> course: parent.height - self.height;
            y: zone.content-height > zone.height ? -zone.content-y / (zone.content-height - zone.height) * self.course : 0;
            height: Math.max(32px, parent.height * zone.height / zone.content-height);
            border-radius: 4px;
            background: Theme.gris.with-alpha(0.45);
            opacity: root.montree ? 1 : 0;
            animate opacity { duration: Mouvement.d; easing: Courbes.sortie; }
        }
        poignee-zone := TouchArea {
            property <length> depart;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    self.depart = zone.content-y;
                }
            }
            moved => {
                if (self.pressed && poignee.course > 0) {
                    zone.content-y = Math.clamp(self.depart - (self.mouse-y - self.pressed-y) / poignee.course * (zone.content-height - zone.height), zone.height - zone.content-height, 0);
                }
            }
        }
    }
}

export { ListView as ListeVirtuelle }
