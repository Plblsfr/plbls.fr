import { BarreDefilement } from "defilement.slint";

component ListView {
    out property <length> visible-width <=> zone.width;
    out property <length> visible-height <=> zone.height;
    in-out property <length> content-width <=> zone.content-width;
    in-out property <length> content-height <=> zone.content-height;
    in-out property <length> content-x <=> zone.content-x;
    in-out property <length> content-y <=> zone.content-y;
    property <duration> dernier-geste;
    property <bool> en-mouvement: false;
    preferred-height: 100%;
    preferred-width: 100%;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    accessible-role: list;
    survol := TouchArea {
        mouse-cursor: default;
    }
    zone := Flickable {
        width: 100%;
        height: 100%;
        mouse-drag-pan-enabled: false;
        flicked => {
            root.dernier-geste = animation-tick();
            root.en-mouvement = true;
        }
        @children
    }
    Timer {
        interval: 150ms;
        running: root.en-mouvement;
        triggered => {
            if (animation-tick() - root.dernier-geste > 600ms) {
                root.en-mouvement = false;
            }
        }
    }
    BarreDefilement {
        x: parent.width - 10px;
        y: 2px;
        height: parent.height - 4px;
        content-y <=> zone.content-y;
        content-height: zone.content-height;
        vue: zone.height;
        survol: survol.has-hover;
        en-mouvement: root.en-mouvement;
    }
}

export { ListView as ListeVirtuelle }
