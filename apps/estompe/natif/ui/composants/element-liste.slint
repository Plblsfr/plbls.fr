import { Theme, Typo, Rayon, Espace, Mouvement, Courbes, Calques } from "../jetons.slint";
import { Icone } from "icone.slint";
import { Anneau } from "focus.slint";
import { Compteur } from "compteur.slint";
import { Etiquette } from "etiquette.slint";
import { DonneesMenu } from "menu.slint";

export component ElementListe {
    in property <string> texte;
    in property <string> icone;
    in property <bool> actif: false;
    in property <bool> non-lu: false;
    in property <int> non-lus: 0;
    in property <int> mentions: 0;
    in property <string> etiquette;
    in property <string> duree;
    in property <string> description;
    in property <bool> brouillon: false;
    in property <int> calque: 0;
    in property <bool> avec-menu: false;
    in property <bool> depot-actif: false;
    in property <bool> depot-propose: false;
    out property <bool> a-le-focus: portee.has-focus;
    out property <bool> survol-depot: depot.has-drag;
    callback clique();
    callback menu(length, length);
    callback peut-deposer(data-transfer) -> bool;
    callback depose(data-transfer);
    property <bool> menu-ouvert: DonneesMenu.ouvert;
    property <bool> a-ouvert-menu: false;
    changed menu-ouvert => {
        if (!self.menu-ouvert && self.a-ouvert-menu) {
            self.a-ouvert-menu = false;
            if (!DonneesMenu.focus-ailleurs) {
                portee.focus();
            }
        }
    }
    function ouvrir-menu(x: length, y: length) {
        if (root.avec-menu && root.utilisable) {
            root.a-ouvert-menu = true;
            root.menu(x, y);
        }
    }
    property <bool> utilisable: calque >= Calques.ouverts;
    property <bool> fort: actif || non-lu || non-lus > 0 || mentions > 0;
    property <color> encre: fort || zone.has-hover ? Theme.encre : Theme.gris;
    min-height: 36px;
    horizontal-stretch: 1;
    accessible-role: button;
    accessible-label: texte;
    accessible-description: description;
    accessible-enabled: utilisable;
    accessible-action-default => {
        if (root.utilisable) {
            root.clique();
        }
    }
    forward-focus: portee;
    Rectangle {
        border-radius: Rayon.s;
        background: depot.has-drag ? Theme.rose-doux : root.actif ? Theme.surface : zone.has-hover ? Theme.encre.with-alpha(0.05) : transparent;
        border-width: root.depot-propose || depot.has-drag ? 1.5px : root.actif ? 1px : 0;
        border-color: root.depot-propose || depot.has-drag ? Theme.rose-fonce : Theme.trait;
        animate background { duration: Mouvement.d; easing: Courbes.sortie; }
    }
    Anneau {
        width: parent.width + 8px;
        height: parent.height + 8px;
        actif: portee.has-focus && portee.clavier;
    }
    portee := FocusScope {
        property <bool> clavier: false;
        enabled: root.utilisable;
        focus-on-click: false;
        focus-gained(raison) => {
            self.clavier = raison != FocusReason.pointer-click;
        }
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") {
                root.clique();
                return accept;
            }
            if (root.avec-menu && (e.text == Key.Menu || (e.modifiers.shift && e.text == Key.F10))) {
                root.ouvrir-menu(root.absolute-position.x + 12px, root.absolute-position.y + root.height);
                return accept;
            }
            return reject;
        }
        zone := TouchArea {
            enabled: root.utilisable;
            mouse-cursor: pointer;
            clicked => {
                root.clique();
            }
            pointer-event(e) => {
                if (root.avec-menu && e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                    root.ouvrir-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 10px;
        if root.icone != "": VerticalLayout {
            alignment: center;
            Icone {
                nom: root.icone;
                taille: 16px;
                couleur: root.encre;
            }
        }
        @children
        Text {
            horizontal-stretch: 1;
            text: root.texte;
            color: root.encre;
            font-family: Typo.texte;
            font-size: 14.5px;
            font-weight: root.fort ? Typo.demi-gras : Typo.normal;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.duree != "": Text {
            text: root.duree;
            color: Theme.encre-2;
            font-family: Typo.mono;
            font-size: 11.5px;
            vertical-alignment: center;
            accessible-role: text;
            accessible-label: "Présence dans le salon : \{root.duree}";
        }
        if root.etiquette != "": VerticalLayout {
            alignment: center;
            Etiquette {
                texte: root.etiquette;
            }
        }
        if root.brouillon: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 13px;
                height: 13px;
                accessible-role: image;
                accessible-label: "Brouillon";
                Icone {
                    nom: "edit";
                    taille: 13px;
                    couleur: Theme.gris;
                }
            }
        }
        if root.mentions > 0 || root.non-lus > 0: VerticalLayout {
            alignment: center;
            Compteur {
                nombre: root.mentions > 0 ? root.mentions : root.non-lus;
                mention: root.mentions > 0;
            }
        }
    }
    depot := DropArea {
        enabled: root.depot-actif;
        can-drop(e) => {
            return root.peut-deposer(e.data) ? DragAction.move : DragAction.none;
        }
        dropped(e) => {
            root.depose(e.data);
            return DragAction.move;
        }
    }
}
