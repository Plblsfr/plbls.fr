import { Theme, Typo, Rayon, Espace } from "../jetons.slint";
import { Icone, Bouton, VarianteBouton, Vide } from "../composants.slint";
import { DonneesCoquille, GenreVue, OngletMarge } from "donnees.slint";
import { Bandeau } from "bandeau.slint";
import { VueAccueil } from "accueil.slint";
import { DonneesMessagerie } from "../messagerie/donnees.slint";
import { DonneesRecherche } from "recherche.slint";
import { VueMessages } from "../messagerie/vue.slint";
import { DonneesVocal } from "../vocal/donnees.slint";
import { VueSalonVocal } from "../vocal/vue.slint";
import { PageParametres, DonneesParametres } from "../parametres/page.slint";
import { PageReglagesServeur, DonneesReglagesServeur } from "reglages-serveur.slint";
import { PageAdmin } from "../admin/page.slint";
import { DonneesAdmin } from "../admin/donnees.slint";

export component Contenu inherits Rectangle {
    callback rejoindre();
    background: Theme.papier;
    VerticalLayout {
        Bandeau {
            etat: DonneesCoquille.bandeau;
        }
        if !DonneesVocal.plein-cadre && !(DonneesParametres.ouverte || DonneesReglagesServeur.ouverte || DonneesAdmin.ouverte): Rectangle {
            height: 60px;
            HorizontalLayout {
                padding-left: DonneesCoquille.panneau-replie ? Espace.e3 : Espace.e6;
                padding-right: Espace.e3;
                spacing: 10px;
                if DonneesCoquille.panneau-replie: VerticalLayout {
                    alignment: center;
                    Bouton {
                        icone: "panneau";
                        description: "Déplier le panneau";
                        variante: VarianteBouton.fantome;
                        clique => {
                            DonneesCoquille.panneau-bascule(false);
                        }
                    }
                }
                if DonneesCoquille.vue.icone != "": VerticalLayout {
                    alignment: center;
                    Icone {
                        nom: DonneesCoquille.vue.icone;
                        taille: 18px;
                        couleur: Theme.gris;
                    }
                }
                titre := Text {
                    text: DonneesCoquille.vue.titre;
                    color: Theme.encre;
                    font-family: Typo.titre;
                    font-size: 18px;
                    font-weight: Typo.gras;
                    letter-spacing: -0.5px;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: text;
                }
                Text {
                    horizontal-stretch: 1;
                    text: DonneesCoquille.vue.sujet;
                    color: Theme.gris;
                    font-size: Typo.petit;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if DonneesCoquille.vue.genre == GenreVue.vocal && DonneesVocal.vue.ici: Text {
                    text: DonneesVocal.vue.compte;
                    color: Theme.gris;
                    font-family: Typo.mono;
                    font-size: Typo.petit;
                    vertical-alignment: center;
                    accessible-role: text;
                    accessible-label: "Participants : \{DonneesVocal.vue.compte}";
                }
                if DonneesCoquille.vue.genre == GenreVue.vocal && DonneesVocal.vue.ici && !DonneesVocal.vue.connexion: VerticalLayout {
                    alignment: center;
                    Bouton {
                        icone: "agrandir";
                        description: "Mode plein cadre";
                        variante: VarianteBouton.fantome;
                        clique => {
                            DonneesVocal.basculer-plein-cadre(true);
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Bouton {
                        icone: "cherche";
                        description: "Rechercher ou aller à… (Ctrl+K)";
                        variante: VarianteBouton.fantome;
                        clique => {
                            DonneesRecherche.ouvrir();
                        }
                    }
                }
                if DonneesCoquille.epingles-disponibles: VerticalLayout {
                    alignment: center;
                    Bouton {
                        icone: "epingle";
                        description: "Messages épinglés";
                        variante: DonneesCoquille.marge-ouverte && DonneesCoquille.onglet-marge == OngletMarge.epingles ? VarianteBouton.secondaire : VarianteBouton.fantome;
                        clique => {
                            DonneesCoquille.epingles-bascule();
                        }
                    }
                }
                if DonneesCoquille.membres-disponibles: VerticalLayout {
                    alignment: center;
                    Bouton {
                        icone: "gens";
                        description: "Membres";
                        variante: DonneesCoquille.marge-ouverte && DonneesCoquille.onglet-marge == OngletMarge.membres ? VarianteBouton.secondaire : VarianteBouton.fantome;
                        clique => {
                            if (DonneesCoquille.marge-ouverte && DonneesCoquille.onglet-marge != OngletMarge.membres) {
                                DonneesCoquille.onglet-marge-choisi(OngletMarge.membres);
                            } else {
                                DonneesCoquille.marge-bascule(!DonneesCoquille.marge-ouverte);
                            }
                        }
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.trait;
            }
        }
        if DonneesParametres.ouverte: PageParametres {
            vertical-stretch: 1;
        }
        if DonneesReglagesServeur.ouverte && !DonneesParametres.ouverte: PageReglagesServeur {
            vertical-stretch: 1;
        }
        if DonneesAdmin.ouverte && !DonneesParametres.ouverte && !DonneesReglagesServeur.ouverte: PageAdmin {
            vertical-stretch: 1;
        }
        if !(DonneesParametres.ouverte || DonneesReglagesServeur.ouverte || DonneesAdmin.ouverte) && DonneesCoquille.vue.genre == GenreVue.accueil: VueAccueil {
            vertical-stretch: 1;
            rejoindre => {
                root.rejoindre();
            }
        }
        if !(DonneesParametres.ouverte || DonneesReglagesServeur.ouverte || DonneesAdmin.ouverte) && (DonneesCoquille.vue.genre == GenreVue.salon || DonneesCoquille.vue.genre == GenreVue.prive) && DonneesMessagerie.active: VueMessages {
            vertical-stretch: 1;
        }
        if !(DonneesParametres.ouverte || DonneesReglagesServeur.ouverte || DonneesAdmin.ouverte) && DonneesCoquille.vue.genre == GenreVue.vocal: VueSalonVocal {
            vertical-stretch: 1;
        }
        if !(DonneesParametres.ouverte || DonneesReglagesServeur.ouverte || DonneesAdmin.ouverte) && DonneesCoquille.vue.genre != GenreVue.accueil && DonneesCoquille.vue.genre != GenreVue.vocal && !((DonneesCoquille.vue.genre == GenreVue.salon || DonneesCoquille.vue.genre == GenreVue.prive) && DonneesMessagerie.active): VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            padding: Espace.e8;
            HorizontalLayout {
                alignment: center;
                Vide {
                    preferred-width: 520px;
                    max-width: 520px;
                    icone: DonneesCoquille.vue.genre == GenreVue.salon || DonneesCoquille.vue.genre == GenreVue.prive ? "bulle" : DonneesCoquille.vue.icone;
                    titre: DonneesCoquille.vue.message;
                    texte: DonneesCoquille.vue.detail;
                }
            }
        }
    }
}
