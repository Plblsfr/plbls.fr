import { EtatPresence } from "../composants/avatar.slint";

export { EtatPresence }

export enum GenreVue { accueil, salon, vocal, esquisse, prive, section }

export enum EtatBandeau { aucun, reconnexion, hors-ligne }

export enum GenrePanneau { accueil, serveur, section }

export struct LigneServeur {
    id: string,
    nom: string,
    initiales: string,
    image: image,
    a-image: bool,
    actif: bool,
    non-lus: int,
    mentions: int,
}

export struct LigneSalon {
    id: string,
    nom: string,
    icone: string,
    titre-groupe: string,
    genre-groupe: string,
    actif: bool,
    non-lus: int,
    mentions: int,
    bientot: bool,
    occupants: int,
    brouillon: bool,
    duree: string,
    vocal: bool,
}

export struct LignePrive {
    id: string,
    pseudo: string,
    initiales: string,
    teinte: int,
    actif: bool,
    non-lus: int,
    mentions: int,
    presence: EtatPresence,
    libelle-presence: string,
    brouillon: bool,
}

export struct LigneSection {
    id: string,
    nom: string,
    icone: string,
    actif: bool,
}

export struct LigneRattrapage {
    cle: string,
    titre: string,
    detail: string,
    icone: string,
    nombre: int,
    mention: bool,
}

export struct LigneVocal {
    cle: string,
    nom: string,
    lieu: string,
    icone: string,
    occupants: int,
}

export struct LigneContact {
    id: string,
    pseudo: string,
    initiales: string,
    teinte: int,
    presence: EtatPresence,
    detail: string,
}

export struct EnTetePanneau {
    genre: GenrePanneau,
    titre: string,
    initiales: string,
    image: image,
    a-image: bool,
    peut-creer-salon: bool,
}

export struct VueContenu {
    genre: GenreVue,
    titre: string,
    sujet: string,
    icone: string,
    message: string,
    detail: string,
}

export struct Accueil {
    actif: bool,
    non-lus: int,
    mentions: int,
    date: string,
    salut: string,
    resume: string,
    sans-serveur: bool,
    contacts: string,
}

export struct LigneBadge {
    nom: string,
    description: string,
    couleur: color,
    image: image,
    a-image: bool,
}

export struct LigneMembre {
    cle: string,
    en-tete: bool,
    titre: string,
    couleur-titre: color,
    a-couleur-titre: bool,
    utilisateur: string,
    nom: string,
    pseudo: string,
    initiales: string,
    teinte: int,
    portrait: image,
    presence: EtatPresence,
    libelle-presence: string,
    activite: string,
    ecoute: string,
    couleur: color,
    a-couleur: bool,
    createur: bool,
    bot: bool,
    exclu: bool,
    badge-1: LigneBadge,
    badge-2: LigneBadge,
    nombre-badges: int,
}

export enum OngletMarge { membres, epingles }

export struct EnTeteMarge {
    titre: string,
    filtrable: bool,
    vide: bool,
}

export struct RoleProfil {
    nom: string,
    couleur: color,
    a-couleur: bool,
}

export struct CarteProfil {
    utilisateur: string,
    nom: string,
    pseudo-origine: string,
    initiales: string,
    teinte: int,
    portrait: image,
    couleur: color,
    a-couleur: bool,
    banniere: color,
    presence: EtatPresence,
    statut: string,
    exclu-jusqu-au: string,
    rang: string,
    roles: [RoleProfil],
    badges: [LigneBadge],
    serveur: string,
    arrivee: string,
    creation: string,
    bot: bool,
    moi: bool,
    moderable: bool,
}

export global DonneesCoquille {
    in property <int> demande-focus: 0;
    in property <[LigneServeur]> serveurs;
    in property <[LigneSalon]> salons;
    in property <[LignePrive]> prives;
    in property <[LigneSection]> sections;
    in property <[LigneRattrapage]> rattrapage;
    in property <[LigneVocal]> vocaux;
    in property <[LigneContact]> contacts;
    in property <EnTetePanneau> panneau;
    in property <VueContenu> vue;
    in property <Accueil> accueil;
    in property <bool> pret: false;
    in property <EtatBandeau> bandeau: EtatBandeau.aucun;
    in property <string> pseudo;
    in property <string> initiales;
    in property <image> portrait;
    in property <EtatPresence> presence: EtatPresence.en-ligne;
    in property <string> statut: "En ligne";
    in-out property <bool> panneau-replie: false;
    in property <bool> marge-disponible: false;
    in-out property <bool> marge-ouverte: false;
    in property <bool> membres-disponibles: false;
    in property <bool> epingles-disponibles: false;
    in property <OngletMarge> onglet-marge: OngletMarge.membres;
    in property <length> largeur-marge: 320px;
    in property <[LigneMembre]> membres;
    in property <EnTeteMarge> marge;
    in-out property <length> defilement-membres: 0;
    in-out property <string> filtre-membres;
    in property <bool> carte-ouverte: false;
    in property <CarteProfil> carte;
    callback ouvrir-accueil();
    callback ouvrir-serveur(string);
    callback ouvrir-salon(string);
    callback ouvrir-prive(string);
    callback ouvrir-section(string);
    callback ouvrir-conversation(string);
    callback deplacer-serveur(string, string);
    callback serveur-voisin(bool);
    callback panneau-bascule(bool);
    callback marge-bascule(bool);
    callback onglet-marge-choisi(OngletMarge);
    callback epingles-bascule();
    callback menu-salon(string, length, length);
    callback menu-serveur(string, length, length);
    callback menu-prive(string, length, length);
    callback menu-membre(string, length, length);
    callback menu-moderation(string, length, length, length);
    callback membres-defiles(length, length);
    callback filtrer-membres(string);
    callback ouvrir-membre(string);
    callback fermer-carte();
    callback tout-lire();
    callback menu-moi(length, length, length);
    callback nouveau-prive();
    callback creer-salon(string);
}
