import { Theme, Typo, Rayon, Espace, Mouvement, Courbes, Calques } from "../jetons.slint";
import { Icone, Bouton, VarianteBouton, Avatar, ElementListe, Compteur, Defilement, Coins, DonneesMenu } from "../composants.slint";
import { Anneau } from "../composants/focus.slint";
import { DonneesCoquille, GenrePanneau, GenreVue, EtatBandeau, EtatPresence } from "donnees.slint";
import { DonneesVocal } from "../vocal/donnees.slint";
import { LigneParticipant } from "../vocal/tuile.slint";
import { BarreVocalPanneau } from "../vocal/barre.slint";
import { BandeauMiseAJour } from "../mise-a-jour/bandeau.slint";
import { DonneesMiseAJour } from "../mise-a-jour/donnees.slint";

component TitreGroupe {
    in property <string> texte;
    min-height: 34px;
    HorizontalLayout {
        padding-left: 10px;
        padding-bottom: 6px;
        Text {
            text: root.texte;
            color: Theme.gris;
            font-family: Typo.mono;
            font-size: 10.5px;
            font-weight: Typo.moyen;
            letter-spacing: 0.8px;
            vertical-alignment: bottom;
            overflow: elide;
        }
    }
}

component BoutonMoi {
    property <bool> hors-ligne: DonneesCoquille.bandeau == EtatBandeau.hors-ligne;
    property <bool> utilisable: Calques.ouverts == 0;
    property <bool> menu-ouvert: DonneesMenu.ouvert;
    property <bool> a-ouvert-menu: false;
    changed menu-ouvert => {
        if (!self.menu-ouvert && self.a-ouvert-menu) {
            self.a-ouvert-menu = false;
            if (!DonneesMenu.focus-ailleurs) {
                portee.focus();
            }
        }
    }
    function ouvrir-menu() {
        if (root.utilisable) {
            root.a-ouvert-menu = true;
            DonneesCoquille.menu-moi(root.absolute-position.x, root.absolute-position.y, root.absolute-position.y + root.height);
        }
    }
    horizontal-stretch: 1;
    accessible-role: button;
    accessible-label: DonneesCoquille.pseudo;
    accessible-description: "Statut : " + (root.hors-ligne ? "Hors ligne" : DonneesCoquille.statut);
    accessible-enabled: root.utilisable;
    accessible-action-default => {
        root.ouvrir-menu();
    }
    Rectangle {
        border-radius: Rayon.s;
        background: zone.has-hover && root.utilisable ? Theme.papier-2 : transparent;
        animate background { duration: Mouvement.d; easing: Courbes.sortie; }
    }
    Anneau {
        width: parent.width + 8px;
        height: parent.height + 8px;
        actif: portee.has-focus && portee.clavier;
    }
    portee := FocusScope {
        property <bool> clavier: false;
        enabled: root.utilisable;
        focus-on-click: false;
        focus-gained(raison) => {
            self.clavier = raison != FocusReason.pointer-click;
        }
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " " || e.text == Key.Menu || (e.modifiers.shift && e.text == Key.F10)) {
                root.ouvrir-menu();
                return accept;
            }
            return reject;
        }
        zone := TouchArea {
            enabled: root.utilisable;
            mouse-cursor: pointer;
            clicked => {
                portee.focus();
                root.ouvrir-menu();
            }
        }
    }
    HorizontalLayout {
        padding: 4px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Avatar {
                nom: DonneesCoquille.pseudo;
                initiales: DonneesCoquille.initiales;
                taille: 32px;
                teinte: 1;
                presence: root.hors-ligne ? EtatPresence.hors-ligne : DonneesCoquille.presence;
                fond: Theme.surface;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: DonneesCoquille.pseudo;
                color: Theme.encre;
                font-family: Typo.texte;
                font-size: 14px;
                font-weight: Typo.gras;
                overflow: elide;
            }
            Text {
                text: root.hors-ligne ? "Hors ligne" : DonneesCoquille.statut;
                color: Theme.gris;
                font-family: Typo.texte;
                font-size: Typo.minuscule;
                overflow: elide;
            }
        }
    }
}

component BarreMoi inherits Rectangle {
    callback se-deconnecter();
    border-radius: Rayon.m;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.trait;
    HorizontalLayout {
        padding: 4px;
        padding-right: Espace.e2;
        spacing: 6px;
        BoutonMoi { }
        VerticalLayout {
            alignment: center;
            Bouton {
                icone: "sortie";
                description: "Se déconnecter";
                variante: VarianteBouton.fantome;
                clique => {
                    root.se-deconnecter();
                }
            }
        }
    }
}

export component Panneau inherits Rectangle {
    callback se-deconnecter();
    width: 272px;
    background: Theme.papier-2;
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.trait;
    }
    VerticalLayout {
        Rectangle {
            height: 60px;
            HorizontalLayout {
                padding-left: 18px;
                padding-right: Espace.e2;
                spacing: Espace.e2;
                if DonneesCoquille.panneau.genre == GenrePanneau.serveur: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: Rayon.s;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.trait;
                        clip: true;
                        if DonneesCoquille.panneau.a-image: Image {
                            width: 100%;
                            height: 100%;
                            source: DonneesCoquille.panneau.image;
                            image-fit: cover;
                        }
                        if DonneesCoquille.panneau.a-image: Coins {
                            width: 100%;
                            height: 100%;
                            rayon: Rayon.s;
                            couleur: Theme.papier-2;
                        }
                        if !DonneesCoquille.panneau.a-image: Text {
                            text: DonneesCoquille.panneau.initiales;
                            color: Theme.encre;
                            font-family: Typo.titre;
                            font-size: 11px;
                            font-weight: 800;
                        }
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: DonneesCoquille.panneau.titre;
                    color: Theme.encre;
                    font-family: Typo.titre;
                    font-size: 17px;
                    font-weight: Typo.gras;
                    vertical-alignment: center;
                    overflow: elide;
                }
                VerticalLayout {
                    alignment: center;
                    Bouton {
                        icone: "panneau";
                        description: "Replier le panneau";
                        variante: VarianteBouton.fantome;
                        clique => {
                            DonneesCoquille.panneau-bascule(true);
                        }
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.trait;
            }
        }
        Defilement {
            vertical-stretch: 1;
            hauteur-contenu: liste.preferred-height;
            liste := VerticalLayout {
                alignment: start;
                padding-top: Espace.e2;
                padding-bottom: Espace.e2;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 1px;
                if DonneesCoquille.panneau.genre == GenrePanneau.accueil: ElementListe {
                    texte: "Accueil";
                    icone: "maison";
                    actif: DonneesCoquille.vue.genre == GenreVue.accueil;
                    clique => {
                        DonneesCoquille.ouvrir-accueil();
                    }
                }
                if DonneesCoquille.panneau.genre == GenrePanneau.accueil: HorizontalLayout {
                    TitreGroupe {
                        horizontal-stretch: 1;
                        min-height: 40px;
                        texte: "CONVERSATIONS";
                    }
                    VerticalLayout {
                        alignment: end;
                        Bouton {
                            icone: "plus";
                            description: "Nouveau message privé";
                            variante: VarianteBouton.fantome;
                            clique => {
                                DonneesCoquille.nouveau-prive();
                            }
                        }
                    }
                }
                if DonneesCoquille.panneau.genre == GenrePanneau.accueil: VerticalLayout {
                    spacing: 1px;
                    for prive in DonneesCoquille.prives: ElementListe {
                        texte: prive.pseudo;
                        actif: prive.actif;
                        non-lus: prive.non-lus;
                        mentions: prive.mentions;
                        description: prive.libelle-presence;
                        brouillon: prive.brouillon;
                        avec-menu: true;
                        clique => {
                            DonneesCoquille.ouvrir-prive(prive.id);
                        }
                        menu(x, y) => {
                            DonneesCoquille.menu-prive(prive.id, x, y);
                        }
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 26px;
                                height: 26px;
                                Avatar {
                                    nom: prive.pseudo;
                                    initiales: prive.initiales;
                                    teinte: prive.teinte;
                                    taille: 26px;
                                    presence: prive.presence;
                                    fond: Theme.papier-2;
                                }
                            }
                        }
                    }
                    if DonneesCoquille.prives.length == 0: HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: "Aucune conversation pour l'instant.";
                            color: Theme.gris;
                            font-size: Typo.petit;
                            wrap: word-wrap;
                        }
                    }
                }
                if DonneesCoquille.panneau.genre == GenrePanneau.serveur: VerticalLayout {
                    spacing: 1px;
                    for salon in DonneesCoquille.salons: VerticalLayout {
                        spacing: 1px;
                        if salon.titre-groupe != "": TitreGroupe {
                            texte: salon.titre-groupe;
                        }
                        ElementListe {
                            texte: salon.nom;
                            icone: salon.icone;
                            actif: salon.actif;
                            non-lus: salon.non-lus;
                            mentions: salon.mentions;
                            non-lu: salon.occupants > 0;
                            etiquette: salon.bientot ? "bientôt" : "";
                            duree: salon.duree;
                            description: salon.bientot ? "bientôt dans l'app native" : "";
                            brouillon: salon.brouillon;
                            avec-menu: true;
                            depot-actif: salon.vocal;
                            depot-propose: salon.vocal && DonneesVocal.glisse-depuis != "" && DonneesVocal.glisse-depuis != salon.id;
                            clique => {
                                DonneesCoquille.ouvrir-salon(salon.id);
                            }
                            menu(x, y) => {
                                DonneesCoquille.menu-salon(salon.id, x, y);
                            }
                            peut-deposer(d) => {
                                return DonneesVocal.peut-deposer(d, salon.id);
                            }
                            depose(d) => {
                                DonneesVocal.deposer(d, salon.id);
                            }
                        }
                        if DonneesVocal.erreur-depot != "" && DonneesVocal.erreur-depot-salon == salon.id: HorizontalLayout {
                            padding-left: 30px;
                            padding-right: 8px;
                            padding-bottom: 4px;
                            Text {
                                text: DonneesVocal.erreur-depot;
                                color: Theme.danger;
                                font-size: Typo.minuscule;
                                wrap: word-wrap;
                                accessible-role: text;
                                accessible-label: self.text;
                            }
                        }
                        if salon.occupants > 0 || DonneesVocal.barre.salon == salon.id: VerticalLayout {
                            for p in DonneesVocal.participants: LigneParticipant {
                                visible: p.salon == salon.id;
                                height: self.visible ? 30px : 0px;
                                p: p;
                            }
                        }
                    }
                    if DonneesCoquille.salons.length == 0: HorizontalLayout {
                        padding-left: 10px;
                        Text {
                            text: "Aucun salon visible.";
                            color: Theme.gris;
                            font-size: Typo.petit;
                        }
                    }
                }
                if DonneesCoquille.panneau.genre == GenrePanneau.section: HorizontalLayout {
                    padding: 10px;
                    Text {
                        text: "Cette section arrive bientôt dans l'app native.";
                        color: Theme.gris;
                        font-size: Typo.petit;
                        wrap: word-wrap;
                    }
                }
            }
        }
        VerticalLayout {
            padding: Espace.e2;
            spacing: Espace.e2;
            if DonneesVocal.barre.visible: BarreVocalPanneau { }
            if DonneesMiseAJour.automatique && (DonneesMiseAJour.proposee || DonneesMiseAJour.compte-a-rebours > 0): BandeauMiseAJour { }
            BarreMoi {
                se-deconnecter => {
                    root.se-deconnecter();
                }
            }
        }
    }
}
