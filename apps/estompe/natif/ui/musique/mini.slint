import { Theme, Typo, Rayon, Espace } from "../jetons.slint";
import { Icone } from "../composants.slint";
import { MiniProgression } from "../composants/mini-progression.slint";
import { PetitBouton } from "../videos/vue.slint";
import { DonneesMusique, MiniMusique } from "donnees.slint";

export component Pochette inherits Rectangle {
    in property <image> source;
    in property <bool> presente;
    in property <length> cote: 36px;
    width: root.cote;
    height: root.cote;
    border-radius: Rayon.xs;
    background: Theme.papier-3;
    clip: true;
    accessible-role: none;
    if root.presente: Image {
        width: 100%;
        height: 100%;
        source: root.source;
        image-fit: cover;
    }
    if !root.presente: Icone {
        nom: "note";
        taille: Math.max(14px, root.cote * 0.4);
        couleur: Theme.gris;
    }
}

export component MiniMusiqueVue inherits Rectangle {
    in property <MiniMusique> m;
    border-radius: Rayon.m;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.trait;
    accessible-role: groupbox;
    accessible-label: "En cours de lecture";
    vertical-stretch: 0;
    height: contenu.preferred-height;
    contenu := VerticalLayout {
        padding: Espace.e2;
        spacing: 2px;
        HorizontalLayout {
            spacing: 10px;
            Pochette {
                y: (parent.height - self.height) / 2;
                source: root.m.pochette;
                presente: root.m.a-pochette;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: root.m.titre;
                    color: Theme.encre;
                    font-size: Typo.petit;
                    font-weight: Typo.demi-gras;
                    overflow: elide;
                    accessible-role: text;
                }
                Text {
                    text: root.m.sous-titre;
                    color: Theme.gris;
                    font-size: 11.5px;
                    overflow: elide;
                }
            }
            if root.m.peut-piloter: PetitBouton {
                y: (parent.height - self.height) / 2;
                icone: root.m.lecture ? "pause" : "lecture";
                description: root.m.lecture ? "Pause" : "Lecture";
                clique => {
                    DonneesMusique.mini-basculer(root.m.salon);
                }
            }
        }
        MiniProgression {
            position: root.m.position;
            duree: root.m.duree;
            texte-position: root.m.texte-position;
            texte-duree: root.m.texte-duree;
            texte-restant: root.m.texte-restant;
            utilisable: root.m.peut-piloter;
            aller(v) => {
                DonneesMusique.mini-aller(root.m.salon, v);
            }
        }
    }
}
