import { Theme, ModeTheme, Typo, Rayon, Espace, Mouvement, Calques, Affichage } from "jetons.slint";
import { Icone, Bouton, VarianteBouton, Modal, MenuContextuel, DonneesMenu, EntreeMenu, Confirmation, DonneesConfirmation, DemandeConfirmation, CopieTexte, DonneesCopie } from "composants.slint";
import { APropos } from "a-propos.slint";
import { Demonstration } from "demonstration.slint";
import { Coquille } from "coquille/coquille.slint";
import { MargeMembres } from "coquille/membres.slint";
import { CarteProfilVue } from "coquille/carte-profil.slint";
import { VisionneuseVue } from "messagerie/visionneuse.slint";
import { DonneesCoquille, GenreVue, EtatBandeau, GenrePanneau, LigneServeur, LigneSalon, LignePrive, LigneSection, LigneRattrapage, LigneVocal, LigneContact, EnTetePanneau, VueContenu, Accueil, LigneMembre, LigneBadge, EnTeteMarge, OngletMarge, RoleProfil, CarteProfil, EtatPresence } from "coquille/donnees.slint";
import { DonneesMessagerie, LigneMessage, GenreLigneMessage, ReactionMessage, LecteurMessage, EpingleMessage, EtatEpingles, AnnexesMessage, ReponseMessage, DroitsLigne, EtatConversation, BlocTexte, GenreBloc, SegmentTexte, GenreSegment, PieceJointe, GenrePieceJointe, EtatTelechargement, OptionSondage, SondageMessage, GenreCarte, CarteLien, Visionneuse } from "messagerie/donnees.slint";
import { DonneesSaisie, BandeauSaisie, GenreBandeau, GenreProposition, PropositionSaisie, PieceSaisie } from "messagerie/saisie.slint";
import { DonneesMessageVocal, EtapeVocal } from "messagerie/vocal.slint";
import { DonneesSelecteur, CelluleEmoji, RangeeEmoji, OngletEmoji } from "messagerie/selecteur.slint";
import { CreationSondage, DonneesCreationSondage } from "messagerie/creation-sondage.slint";
import { DonneesGifs, CelluleGif, RangeeGif } from "messagerie/gifs.slint";
import { Recherche, DonneesRecherche, EntreePalette, MorceauExtrait, ResultatRecherche, PorteeRecherche } from "coquille/recherche.slint";
import { NouveauPrive, DonneesNouveauPrive, PersonneProposee } from "coquille/nouveau-prive.slint";
import { Attente } from "entree/commun.slint";
import { Connexion } from "entree/connexion.slint";
import { Refus, Activation, Invitation, Injoignable } from "entree/acces.slint";
import { MiseAJour } from "entree/mise-a-jour.slint";
import { DonneesVocal, ParticipantVocal, VueVocal, BarreVocal, MenuVocal, PeripheriqueVocal, ListePeripheriques, ReglagesVocal, ChoixCameraVocal } from "vocal/donnees.slint";
import { MenuParticipant, ListePeripheriquesVocal } from "vocal/menus.slint";
import { ReglagesAudio } from "vocal/reglages.slint";
import { FenetreJeux, DonneesJeux, JeuAjoute } from "jeux/reglages.slint";
import { DonneesOverlay, DonneesOverlayMessages } from "overlay/reglages.slint";
import { OverlayVoix, LigneOverlayVoix } from "overlay/voix.slint";
import { OverlayMessages, LigneOverlayMessage } from "overlay/messages.slint";
import { OverlayReplay, LigneOverlayReplay } from "overlay/replay.slint";
import { FenetreReplay, DonneesReplay, ChoixReplay } from "replay/reglages.slint";
import { FenetreMesures, DonneesMesures, LigneScenario } from "mesures/ecran.slint";
import { FenetreClips, FenetreEnvoiClip, DonneesClips, LigneClip, JeuClips, TravailClip, DestinationClip } from "replay/galerie.slint";
import { FenetreEditeur, FenetreExportMontage, ChoixClipMontage, DonneesEditeur, SegmentEditeur, PisteEditeur, ChoixEditeur, ProjetMontage, ClipAjoutable } from "replay/editeur.slint";
import { ChoixCamera } from "vocal/camera.slint";
import { ChoixPartage } from "vocal/partage.slint";
import { DonneesVideo, FluxVideo } from "video/flux.slint";

import { DonneesMiseAJour } from "mise-a-jour/donnees.slint";
import { DonneesParametres, OngletParametres, LigneJournal, LigneRaccourci, LigneNotifSalon } from "parametres/page.slint";

export { Theme, ModeTheme, Mouvement, Calques, Affichage, DonneesParametres, OngletParametres, LigneJournal, LigneRaccourci, LigneNotifSalon, DonneesMenu, EntreeMenu, DonneesConfirmation, DemandeConfirmation, DonneesCopie, DonneesCoquille, GenreVue, EtatBandeau, GenrePanneau, LigneServeur, LigneSalon, LignePrive, LigneSection, LigneRattrapage, LigneVocal, LigneContact, EnTetePanneau, VueContenu, Accueil, LigneMembre, LigneBadge, EnTeteMarge, OngletMarge, RoleProfil, CarteProfil, EtatPresence, DonneesMessagerie, LigneMessage, GenreLigneMessage, ReactionMessage, LecteurMessage, EpingleMessage, EtatEpingles, AnnexesMessage, ReponseMessage, DroitsLigne, EtatConversation, BlocTexte, GenreBloc, SegmentTexte, GenreSegment, PieceJointe, GenrePieceJointe, EtatTelechargement, OptionSondage, SondageMessage, GenreCarte, CarteLien, Visionneuse, DonneesSaisie, BandeauSaisie, GenreBandeau, GenreProposition, PropositionSaisie, PieceSaisie, DonneesMessageVocal, EtapeVocal, DonneesSelecteur, CelluleEmoji, RangeeEmoji, OngletEmoji, DonneesCreationSondage, DonneesGifs, CelluleGif, RangeeGif, DonneesRecherche, EntreePalette, MorceauExtrait, ResultatRecherche, PorteeRecherche, DonneesNouveauPrive, PersonneProposee, DonneesVocal, ParticipantVocal, VueVocal, BarreVocal, MenuVocal, PeripheriqueVocal, ListePeripheriques, ReglagesVocal, ChoixCameraVocal, DonneesVideo, FluxVideo, DonneesMiseAJour, DonneesJeux, JeuAjoute, DonneesOverlay, DonneesOverlayMessages, OverlayVoix, LigneOverlayVoix, OverlayMessages, LigneOverlayMessage, OverlayReplay, LigneOverlayReplay, DonneesReplay, ChoixReplay, DonneesMesures, LigneScenario, DonneesClips, LigneClip, JeuClips, TravailClip, DestinationClip, DonneesEditeur, SegmentEditeur, PisteEditeur, ChoixEditeur, ProjetMontage, ClipAjoutable }

export enum Page { demarrage, connexion, verification, refuse, activation, invitation, injoignable, mise-a-jour, coquille }

export component Principale inherits Window {
    in property <string> version;
    in property <bool> debogage: false;
    in property <Page> page: Page.demarrage;
    in-out property <bool> demonstration: false;
    in property <bool> connexion-en-attente: false;
    in property <string> connexion-erreur;
    in property <string> activation-erreur;
    in property <bool> activation-champ-en-faute: false;
    in property <bool> activation-en-cours: false;
    in-out property <string> activation-pseudo;
    in property <string> invitation-erreur;
    in property <bool> invitation-en-cours: false;
    in-out property <string> invitation-saisie;
    in property <string> injoignable-message;
    in property <string> mise-a-jour-message;
    in property <string> mise-a-jour-version-minimale;
    in property <string> pseudo;
    in-out property <bool> a-propos-ouvert: false;
    in property <bool> demarrage-disponible: false;
    in-out property <bool> demarrage-actif: false;
    in-out property <bool> notifications-bureau: true;
    in-out property <bool> modal-demo-ouvert: false;
    in property <bool> infobulle-forcee: false;
    out property <int> clics-demo: demo.clics;
    out property <string> saisie-demo: demo.saisie;
    out property <bool> case-demo: demo.case-cochee;
    out property <bool> interrupteur-demo: demo.interrupteur-allume;
    out property <int> confirmations-demo;
    callback theme-change(ModeTheme);
    callback se-connecter();
    callback creer-compte();
    callback annuler-connexion();
    callback reessayer();
    callback se-deconnecter();
    callback activer(string);
    callback ouvrir-invitation();
    callback rejoindre(string);
    callback retour-accueil();
    callback telecharger-mise-a-jour();
    callback ouvrir-page-mise-a-jour();
    callback demarrage-change(bool);
    callback notifications-change(bool);
    public function focus-demo() {
        demo.focus-initial();
    }
    public function focus-connexion() {
        connexion.focus-initial();
    }
    title: "Estompe natif (beta)";
    icon: @image-url("../icones/estompe.png");
    background: Theme.papier;
    default-font-family: Typo.texte;
    default-font-size: Typo.corps;
    min-width: 720px;
    min-height: 480px;
    preferred-width: 1180px;
    preferred-height: 760px;
    VerticalLayout {
        Rectangle {
            height: 56px;
            background: Theme.papier-2;
            HorizontalLayout {
                padding-left: Espace.e4;
                padding-right: Espace.e3;
                spacing: Espace.e2;
                Text {
                    text: "Estompe";
                    color: Theme.encre;
                    font-family: Typo.titre;
                    font-size: Typo.titre-section;
                    font-weight: Typo.gras;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 20px;
                        width: beta.preferred-width + 12px;
                        border-radius: Rayon.pilule;
                        background: Theme.rose;
                        beta := Text {
                            text: "beta";
                            color: Theme.rose-texte;
                            font-family: Typo.mono;
                            font-size: 11px;
                            font-weight: Typo.moyen;
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: Espace.e2;
                        if root.debogage: Bouton {
                            texte: root.demonstration ? "Retour" : "Composants";
                            variante: VarianteBouton.fantome;
                            clique => {
                                root.demonstration = !root.demonstration;
                            }
                        }
                        Bouton {
                            icone: Theme.sombre ? "soleil" : "lune";
                            variante: VarianteBouton.fantome;
                            description: Theme.sombre ? "Thème clair" : "Thème sombre";
                            clique => {
                                Theme.mode = Theme.sombre ? ModeTheme.clair : ModeTheme.sombre;
                                root.theme-change(Theme.mode);
                            }
                        }
                        Bouton {
                            texte: "À propos";
                            icone: "info";
                            variante: VarianteBouton.fantome;
                            clique => {
                                root.a-propos-ouvert = true;
                            }
                        }
                    }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.trait;
        }
        Rectangle {
            vertical-stretch: 1;
            Rectangle {
                visible: !root.demonstration;
                if root.page == Page.demarrage || root.page == Page.verification: Attente {
                    texte: root.page == Page.demarrage ? "Ouverture d'Estompe…" : "Vérification du compte…";
                }
                connexion := Connexion {
                    visible: root.page == Page.connexion;
                    en-attente: root.connexion-en-attente;
                    erreur: root.connexion-erreur;
                    se-connecter => {
                        root.se-connecter();
                    }
                    creer-compte => {
                        root.creer-compte();
                    }
                    annuler => {
                        root.annuler-connexion();
                    }
                }
                if root.page == Page.refuse: Refus {
                    reessayer => {
                        root.reessayer();
                    }
                    se-deconnecter => {
                        root.se-deconnecter();
                    }
                }
                if root.page == Page.activation: Activation {
                    erreur: root.activation-erreur;
                    champ-en-faute: root.activation-champ-en-faute;
                    en-cours: root.activation-en-cours;
                    pseudo <=> root.activation-pseudo;
                    activer(pseudo) => {
                        root.activer(pseudo);
                    }
                    se-deconnecter => {
                        root.se-deconnecter();
                    }
                }
                if root.page == Page.invitation: Invitation {
                    erreur: root.invitation-erreur;
                    en-cours: root.invitation-en-cours;
                    saisie <=> root.invitation-saisie;
                    rejoindre(saisie) => {
                        root.rejoindre(saisie);
                    }
                    retour => {
                        root.retour-accueil();
                    }
                }
                if root.page == Page.injoignable: Injoignable {
                    message: root.injoignable-message;
                    reessayer => {
                        root.reessayer();
                    }
                    se-deconnecter => {
                        root.se-deconnecter();
                    }
                }
                if root.page == Page.mise-a-jour: MiseAJour {
                    version: root.version;
                    version-minimale: root.mise-a-jour-version-minimale;
                    message: root.mise-a-jour-message;
                    telecharger => {
                        root.telecharger-mise-a-jour();
                    }
                    ouvrir-page => {
                        root.ouvrir-page-mise-a-jour();
                    }
                }
                if root.page == Page.coquille: Coquille {
                    ouvrir-invitation => {
                        root.ouvrir-invitation();
                    }
                    se-deconnecter => {
                        root.se-deconnecter();
                    }
                    if DonneesCoquille.marge-disponible && DonneesCoquille.marge-ouverte: MargeMembres {
                        width: 100%;
                        height: 100%;
                    }
                }
            }
            demo := Demonstration {
                width: 100%;
                height: 100%;
                visible: root.demonstration;
                infobulle-forcee: root.infobulle-forcee;
                ouvrir-modal => {
                    root.modal-demo-ouvert = true;
                }
            }
        }
    }
    Modal {
        titre: "À propos";
        ouvert: root.a-propos-ouvert;
        largeur: 480px;
        ferme => {
            root.a-propos-ouvert = false;
        }
        APropos {
            min-height: 320px;
            version: root.version;
            demarrage-disponible: root.demarrage-disponible;
            demarrage-actif <=> root.demarrage-actif;
            notifications-bureau <=> root.notifications-bureau;
            demarrage-change(actif) => {
                root.demarrage-change(actif);
            }
            notifications-change(actif) => {
                root.notifications-change(actif);
            }
        }
    }
    Modal {
        titre: "Supprimer le message ?";
        ouvert: root.modal-demo-ouvert;
        ferme => {
            root.modal-demo-ouvert = false;
        }
        Text {
            text: "Cette action est définitive.";
            color: Theme.encre-2;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            spacing: Espace.e2;
            Bouton {
                texte: "Annuler";
                calque: 1;
                clique => {
                    root.modal-demo-ouvert = false;
                }
            }
            Bouton {
                texte: "Supprimer";
                variante: VarianteBouton.danger;
                calque: 1;
                clique => {
                    root.confirmations-demo += 1;
                    root.modal-demo-ouvert = false;
                }
            }
        }
    }
    CarteProfilVue {
        ouverte: root.page == Page.coquille && DonneesCoquille.carte-ouverte;
    }
    VisionneuseVue {
        ouverte: root.page == Page.coquille && DonneesMessagerie.visionneuse.ouverte;
    }
    MenuParticipant { }
    ListePeripheriquesVocal { }
    ReglagesAudio { }
    FenetreJeux { }
    FenetreReplay { }
    FenetreMesures { }
    FenetreClips { }
    FenetreEnvoiClip { }
    FenetreEditeur { }
    FenetreExportMontage { }
    ChoixClipMontage { }
    ChoixCamera { }
    ChoixPartage { }
    CreationSondage { }
    Recherche { }
    NouveauPrive { }
    Confirmation { }
    MenuContextuel { }
    CopieTexte { }
}
