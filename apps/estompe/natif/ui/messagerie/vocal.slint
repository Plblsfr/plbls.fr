import { Theme, Typo, Rayon, Espace } from "../jetons.slint";
import { Icone, Bouton, VarianteBouton } from "../composants.slint";
import { DonneesMessagerie, PieceJointe, TranscriptionVocale, EtatTranscription } from "donnees.slint";

export enum EtapeVocal { aucune, ouverture, enregistrement, finalisation, ecoute, envoi }

export global DonneesMessageVocal {
    in property <bool> possible: false;
    in property <EtapeVocal> etape: EtapeVocal.aucune;
    in property <string> duree: "0:00";
    in property <[float]> niveaux;
    in property <[float]> forme;
    in property <bool> echec: false;
    in property <string> piece;
    in property <bool> en-lecture: false;
    in property <bool> chargement: false;
    in property <float> avance: 0;
    in property <string> temps;
    in property <string> vitesse: "1×";
    callback demarrer();
    callback annuler();
    callback arreter();
    callback envoyer();
    callback basculer(string, string);
    callback placer(string, string, float);
    callback changer-vitesse();
    callback transcrire(string);
    callback basculer-transcription(string);
    callback deplier-transcription(string);
    callback modifier-transcription(string, string);
    callback ecrire-transcription(string, string);
    callback annuler-transcription(string);
    callback enregistrer-transcription(string, string);
}

export component Onde inherits Rectangle {
    in property <[float]> valeurs;
    in property <float> avance: 0;
    in property <brush> fait: Theme.encre;
    in property <brush> reste: Theme.trait-fort;
    in property <float> minimum: 0.12;
    height: 32px;
    HorizontalLayout {
        spacing: 2px;
        for v[i] in root.valeurs: Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                width: min(3px, parent.width);
                height: max(3px, parent.height * max(root.minimum, v));
                border-radius: 1.5px;
                background: i / max(1, root.valeurs.length) < root.avance ? root.fait : root.reste;
            }
        }
    }
}

export component BoutonVocal inherits Rectangle {
    in property <string> icone;
    in property <string> libelle;
    in property <bool> actif: true;
    in property <color> encre: Theme.gris;
    in property <brush> fond: transparent;
    in property <length> taille: 18px;
    callback clique();
    forward-focus: portee;
    width: 34px;
    height: 34px;
    border-radius: self.height / 2;
    background: zone.has-hover && root.actif && root.fond == transparent ? Theme.encre.with-alpha(0.06) : root.fond;
    border-width: portee.has-focus ? 2px : 0;
    border-color: Theme.rose-fonce;
    opacity: root.actif ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.libelle;
    accessible-enabled: root.actif;
    accessible-action-default => {
        if (root.actif) {
            root.clique();
        }
    }
    Icone {
        nom: root.icone;
        taille: root.taille;
        couleur: root.encre;
    }
    portee := FocusScope {
        enabled: root.actif;
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") {
                root.clique();
                return accept;
            }
            return reject;
        }
        zone := TouchArea {
            enabled: root.actif;
            mouse-cursor: pointer;
            clicked => {
                root.clique();
            }
        }
    }
}

export component LecteurVocal inherits HorizontalLayout {
    in property <string> message;
    in property <string> piece;
    in property <string> duree;
    in property <[float]> barres;
    property <bool> courant: DonneesMessageVocal.piece == root.piece;
    property <bool> joue: root.courant && DonneesMessageVocal.en-lecture;
    spacing: 10px;
    VerticalLayout {
        alignment: center;
        BoutonVocal {
            width: 36px;
            height: 36px;
            icone: root.joue ? "pause" : "lecture";
            libelle: root.joue ? "Mettre en pause" : "Écouter le message vocal";
            fond: Theme.encre;
            encre: Theme.rose;
            opacity: root.courant && DonneesMessageVocal.chargement ? 0.6 : 1;
            clique => {
                DonneesMessageVocal.basculer(root.message, root.piece);
            }
        }
    }
    onde := Onde {
        horizontal-stretch: 1;
        min-width: 80px;
        valeurs: root.barres;
        avance: root.courant ? DonneesMessageVocal.avance : 0;
        accessible-role: slider;
        accessible-label: "Se placer dans le message vocal";
        accessible-value: temps.text;
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                DonneesMessageVocal.placer(root.message, root.piece, max(0, min(1, self.mouse-x / self.width)));
            }
        }
    }
    temps := Text {
        min-width: 30px;
        text: root.courant && (root.joue || DonneesMessageVocal.avance > 0) ? DonneesMessageVocal.temps : root.duree;
        color: Theme.encre-2;
        font-family: Typo.mono;
        font-size: 12px;
        vertical-alignment: center;
        accessible-role: none;
    }
}

export component MessageVocal inherits Rectangle {
    in property <PieceJointe> piece;
    in property <string> message;
    preferred-width: 380px;
    max-width: 380px;
    height: 48px;
    border-radius: Rayon.s;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.trait;
    accessible-role: groupbox;
    accessible-label: "Message vocal, " + root.piece.duree;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 8px;
        LecteurVocal {
            horizontal-stretch: 1;
            message: root.message;
            piece: root.piece.id;
            duree: root.piece.duree;
            barres: root.piece.barres;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 24px;
                width: vitesse.preferred-width + 12px;
                border-radius: Rayon.xs;
                background: zone-vitesse.has-hover ? Theme.papier-3 : Theme.papier-2;
                accessible-role: button;
                accessible-label: "Vitesse de lecture";
                accessible-value: DonneesMessageVocal.vitesse;
                accessible-action-default => {
                    DonneesMessageVocal.changer-vitesse();
                }
                vitesse := Text {
                    text: DonneesMessageVocal.vitesse;
                    color: Theme.encre-2;
                    font-family: Typo.mono;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                zone-vitesse := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        DonneesMessageVocal.changer-vitesse();
                    }
                }
            }
        }
        if !root.piece.ecoute: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.rose-fonce;
                accessible-role: text;
                accessible-label: "Non écouté";
            }
        }
        VerticalLayout {
            alignment: center;
            BoutonVocal {
                width: 28px;
                height: 28px;
                icone: "telecharge";
                taille: 16px;
                libelle: "Télécharger le message vocal";
                clique => {
                    DonneesMessagerie.telecharger(root.message, root.piece.id);
                }
            }
        }
    }
}

export component VocalIllisible inherits Rectangle {
    in property <PieceJointe> piece;
    in property <string> message;
    min-height: 36px;
    border-radius: Rayon.s;
    background: Theme.attention-fond;
    accessible-role: text;
    accessible-label: "Message vocal illisible sur cet appareil";
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icone {
                nom: "mic";
                taille: 15px;
                couleur: Theme.attention;
            }
        }
        Text {
            text: "Message vocal illisible sur cet appareil";
            color: Theme.attention;
            font-size: 13px;
            vertical-alignment: center;
        }
        Text {
            text: "Télécharger";
            color: Theme.attention;
            font-size: 13px;
            font-weight: Typo.demi-gras;
            vertical-alignment: center;
            accessible-role: button;
            accessible-label: "Télécharger le message vocal";
            accessible-action-default => {
                DonneesMessagerie.telecharger(root.message, root.piece.id);
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    DonneesMessagerie.telecharger(root.message, root.piece.id);
                }
            }
        }
    }
}

component LienTranscription inherits Text {
    callback clique();
    color: Theme.encre-2;
    font-size: 12px;
    font-weight: Typo.demi-gras;
    vertical-alignment: center;
    accessible-role: button;
    accessible-label: self.text;
    accessible-action-default => {
        root.clique();
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clique();
        }
    }
}

component PointTranscription inherits Text {
    text: "·";
    color: Theme.gris;
    font-size: 12px;
    vertical-alignment: center;
    accessible-role: none;
}

export component TranscriptionVue inherits VerticalLayout {
    in property <TranscriptionVocale> transcription;
    in property <string> piece;
    in property <string> message;
    property <bool> repliee: root.transcription.repliable && !root.transcription.depliee;
    spacing: 4px;
    if root.transcription.etat == EtatTranscription.proposee: HorizontalLayout {
        alignment: start;
        Rectangle {
            height: 26px;
            width: transcrire.preferred-width + 20px;
            border-radius: Rayon.pilule;
            border-width: 1px;
            border-color: Theme.trait-fort;
            background: zone-transcrire.has-hover ? Theme.papier-2 : transparent;
            accessible-role: button;
            accessible-label: "Transcrire";
            accessible-action-default => {
                DonneesMessageVocal.transcrire(root.piece);
            }
            transcrire := Text {
                text: "Transcrire";
                color: Theme.encre-2;
                font-size: 12.5px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            zone-transcrire := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    DonneesMessageVocal.transcrire(root.piece);
                }
            }
        }
    }
    if root.transcription.etat == EtatTranscription.demandee: HorizontalLayout {
        alignment: start;
        Rectangle {
            height: 26px;
            width: attente.preferred-width + 20px;
            border-radius: Rayon.pilule;
            background: Theme.papier-2;
            accessible-role: text;
            accessible-label: "Transcription en cours…";
            attente := HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Icone {
                        nom: "onde";
                        taille: 14px;
                        couleur: Theme.gris;
                    }
                }
                Text {
                    text: "Transcription en cours…";
                    color: Theme.gris;
                    font-size: 12.5px;
                    vertical-alignment: center;
                }
            }
        }
    }
    if root.transcription.etat == EtatTranscription.prete: Rectangle {
        preferred-width: 380px;
        max-width: 380px;
        border-radius: Rayon.s;
        background: Theme.papier-2;
        accessible-role: groupbox;
        accessible-label: "Transcription du message vocal";
        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 6px;
            if !root.transcription.masquee: Text {
                text: root.transcription.texte;
                color: Theme.encre;
                font-size: 14px;
                wrap: word-wrap;
                overflow: elide;
                max-height: root.repliee ? 54px : 100000px;
                accessible-role: text;
                accessible-label: root.transcription.texte;
            }
            HorizontalLayout {
                alignment: start;
                spacing: 4px;
                VerticalLayout {
                    alignment: center;
                    Icone {
                        nom: "onde";
                        taille: 13px;
                        couleur: Theme.gris;
                    }
                }
                if root.transcription.auto: Text {
                    text: "TRANSCRIPTION AUTOMATIQUE";
                    color: Theme.gris;
                    font-family: Typo.mono;
                    font-size: 10.5px;
                    vertical-alignment: center;
                }
                if root.transcription.auto: PointTranscription { }
                if root.transcription.repliable: LienTranscription {
                    text: root.transcription.depliee ? "Afficher moins" : "Afficher plus";
                    clique => {
                        DonneesMessageVocal.deplier-transcription(root.piece);
                    }
                }
                if root.transcription.repliable: PointTranscription { }
                LienTranscription {
                    text: root.transcription.masquee ? "Afficher la transcription" : "Masquer";
                    clique => {
                        DonneesMessageVocal.basculer-transcription(root.piece);
                    }
                }
                if root.transcription.modifiable: PointTranscription { }
                if root.transcription.modifiable: LienTranscription {
                    text: "Modifier";
                    clique => {
                        DonneesMessageVocal.modifier-transcription(root.message, root.piece);
                    }
                }
            }
        }
    }
    if root.transcription.etat == EtatTranscription.edition: Rectangle {
        preferred-width: 380px;
        max-width: 380px;
        border-radius: Rayon.s;
        background: Theme.papier-2;
        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 8px;
            Rectangle {
                height: 76px;
                border-radius: Rayon.xs;
                background: Theme.surface;
                border-width: champ.has-focus ? 2px : 1px;
                border-color: champ.has-focus ? Theme.encre : Theme.trait-fort;
                accessible-role: text-input;
                accessible-label: "Transcription du message vocal";
                accessible-value: champ.text;
                clip: true;
                champ := TextInput {
                    x: 10px;
                    y: 8px;
                    width: parent.width - 20px;
                    height: parent.height - 16px;
                    single-line: false;
                    wrap: word-wrap;
                    enabled: !root.transcription.occupee;
                    text: root.transcription.brouillon;
                    color: Theme.encre;
                    font-size: 14px;
                    selection-background-color: Theme.rose;
                    edited => {
                        DonneesMessageVocal.ecrire-transcription(root.piece, self.text);
                    }
                }
            }
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                Bouton {
                    texte: "Enregistrer";
                    variante: VarianteBouton.primaire;
                    en-cours: root.transcription.occupee;
                    clique => {
                        DonneesMessageVocal.enregistrer-transcription(root.piece, champ.text);
                    }
                }
                Bouton {
                    texte: "Annuler";
                    actif: !root.transcription.occupee;
                    clique => {
                        DonneesMessageVocal.annuler-transcription(root.piece);
                    }
                }
            }
        }
    }
    if root.transcription.erreur != "": Text {
        text: root.transcription.erreur;
        color: Theme.danger;
        font-size: 11.5px;
        wrap: word-wrap;
        accessible-role: text;
    }
}
