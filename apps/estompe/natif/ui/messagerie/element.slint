import { Theme, Typo, Rayon, Espace, Mouvement, Courbes, Affichage } from "../jetons.slint";
import { Icone, Avatar, BadgeRole, GenreBadgeRole, Chargement, Separateur, TexteRiche, DonneesMenu } from "../composants.slint";
import { Medaille } from "../coquille/membres.slint";
import { DonneesMessagerie, LigneMessage, GenreLigneMessage, AnnexesMessage, ReponseMessage, GenreCarte } from "donnees.slint";
import { AnnexesMessageVue, SondageVue } from "annexes.slint";

component EnTeteReponse {
    in property <ReponseMessage> reponse;
    accessible-role: button;
    accessible-enabled: !root.reponse.supprimee;
    accessible-label: root.reponse.supprimee ? "Message d'origine supprimé" : "Aller au message de " + root.reponse.auteur;
    accessible-description: root.reponse.texte;
    accessible-action-default => {
        if (!root.reponse.supprimee) {
            DonneesMessagerie.reponse-cliquee(root.reponse.id);
        }
    }
    min-height: 22px;
    zone := TouchArea {
        enabled: !root.reponse.supprimee;
        mouse-cursor: root.reponse.supprimee ? default : pointer;
        clicked => {
            DonneesMessagerie.reponse-cliquee(root.reponse.id);
        }
        HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Icone {
                    nom: "repondre";
                    taille: 14px;
                    couleur: Theme.gris;
                }
            }
            if !root.reponse.supprimee: Text {
                text: root.reponse.auteur;
                color: Theme.encre;
                font-size: Typo.petit;
                font-weight: Typo.demi-gras;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                text: root.reponse.supprimee ? "Message d'origine supprimé" : root.reponse.texte;
                color: zone.has-hover ? Theme.encre-2 : Theme.gris;
                font-size: Typo.petit;
                font-italic: root.reponse.supprimee;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

component BoutonOutil {
    in property <string> icone;
    in property <string> libelle;
    in property <image> image;
    in property <bool> danger: false;
    in property <bool> enfonce: false;
    callback clique();
    out property <bool> survole: zone.has-hover;
    width: 28px;
    height: 28px;
    accessible-role: button;
    accessible-label: root.libelle;
    accessible-action-default => {
        root.clique();
    }
    Rectangle {
        border-radius: Rayon.xs;
        background: zone.has-hover ? (root.danger ? Theme.danger.with-alpha(0.14) : Theme.rose-doux) : root.enfonce ? Theme.rose : transparent;
    }
    if root.image.width > 0: Image {
        width: 18px;
        height: 18px;
        source: root.image;
        image-fit: contain;
    }
    if root.image.width == 0: Icone {
        nom: root.icone;
        taille: 16px;
        couleur: root.danger ? Theme.danger : Theme.encre;
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clique();
        }
    }
}

component BarreActions inherits Rectangle {
    in property <LigneMessage> ligne;
    callback copier(string);
    callback plus(length, length, length);
    out property <bool> survolee: zone.has-hover;
    height: 34px;
    width: rangee.preferred-width;
    border-radius: Rayon.s;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.trait;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Theme.sombre ? #00000066 : #16130f14;
    accessible-role: groupbox;
    accessible-label: "Actions sur le message";
    zone := TouchArea {
        rangee := HorizontalLayout {
            padding: 2px;
            spacing: 1px;
            if root.ligne.droits.reagir: HorizontalLayout {
                spacing: 1px;
                for reaction in DonneesMessagerie.reactions-rapides: BoutonOutil {
                    image: reaction.image;
                    libelle: "Réagir avec " + reaction.emoji;
                    clique => {
                        DonneesMessagerie.reagir(root.ligne.id, reaction.emoji);
                    }
                }
                Rectangle {
                    width: 9px;
                    Rectangle {
                        width: 1px;
                        height: 18px;
                        background: Theme.trait;
                    }
                }
            }
            if root.ligne.droits.repondre: BoutonOutil {
                icone: "repondre";
                libelle: "Répondre";
                clique => {
                    DonneesMessagerie.action-message(root.ligne.id, "repondre");
                }
            }
            if root.ligne.droits.reagir: BoutonOutil {
                icone: "sourire";
                libelle: "Ajouter une réaction";
                clique => {
                    DonneesMessagerie.action-message(root.ligne.id, "reagir");
                }
            }
            if root.ligne.droits.modifier: BoutonOutil {
                icone: "crayon";
                libelle: "Modifier";
                clique => {
                    DonneesMessagerie.action-message(root.ligne.id, "modifier");
                }
            }
            if root.ligne.droits.epingler: BoutonOutil {
                icone: "epingle";
                libelle: root.ligne.epingle ? "Désépingler" : "Épingler";
                enfonce: root.ligne.epingle;
                clique => {
                    DonneesMessagerie.action-message(root.ligne.id, root.ligne.epingle ? "desepingler" : "epingler");
                }
            }
            if root.ligne.texte-brut != "": BoutonOutil {
                icone: "copie";
                libelle: "Copier le message";
                clique => {
                    root.copier(root.ligne.texte-brut);
                }
            }
            if root.ligne.droits.supprimer: BoutonOutil {
                icone: "corbeille";
                libelle: "Supprimer";
                danger: true;
                clique => {
                    DonneesMessagerie.action-message(root.ligne.id, "supprimer");
                }
            }
            if root.ligne.droits.menu: plus := BoutonOutil {
                icone: "plus3";
                libelle: "Plus d'actions";
                clique => {
                    root.plus(self.absolute-position.x, self.absolute-position.y, self.absolute-position.y + self.height);
                }
            }
        }
    }
}

component Debut {
    accessible-role: text;
    accessible-label: "Début de la conversation";
    VerticalLayout {
        padding-left: 72px;
        padding-right: 24px;
        padding-top: Espace.e8;
        padding-bottom: Espace.e4;
        spacing: Espace.e2;
        alignment: start;
        HorizontalLayout {
            alignment: start;
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: Rayon.m;
                background: Theme.papier-2;
                border-width: 1px;
                border-color: Theme.trait;
                Icone {
                    nom: "bulle";
                    taille: 22px;
                    couleur: Theme.gris;
                }
            }
        }
        Text {
            text: "Début de la conversation";
            color: Theme.encre;
            font-family: Typo.titre;
            font-size: 18px;
            font-weight: Typo.gras;
        }
    }
}

component ChargementLigne {
    accessible-role: text;
    accessible-label: "Chargement des messages";
    HorizontalLayout {
        alignment: center;
        padding: Espace.e3;
        spacing: Espace.e2;
        Chargement {
            taille: 18px;
        }
        Text {
            text: "Chargement des messages…";
            color: Theme.gris;
            font-size: Typo.petit;
            vertical-alignment: center;
        }
    }
}

component LienAction inherits Text {
    in property <string> texte;
    callback clique();
    text: root.texte;
    color: zone-lien.has-hover ? Theme.encre : Theme.rose-texte;
    font-size: Typo.minuscule;
    font-weight: Typo.demi-gras;
    vertical-alignment: center;
    accessible-role: button;
    accessible-label: root.texte;
    accessible-action-default => {
        root.clique();
    }
    zone-lien := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clique();
        }
    }
}

component CorpsMessage inherits Rectangle {
    in property <LigneMessage> ligne;
    callback copier(string);
    property <bool> sur-barre: false;
    property <bool> actif: zone.has-hover || portee.has-focus || root.sur-barre;
    property <bool> menu-ouvert: DonneesMenu.ouvert;
    property <bool> a-ouvert-menu: false;
    changed menu-ouvert => {
        if (!self.menu-ouvert && self.a-ouvert-menu) {
            self.a-ouvert-menu = false;
            if (!DonneesMenu.focus-ailleurs) {
                portee.focus();
            }
        }
    }
    function ouvrir-menu(x: length, y: length) {
        if (root.ligne.droits.menu) {
            root.a-ouvert-menu = true;
            DonneesMessagerie.menu-message(root.ligne.id, x, y);
        }
    }
    background: ligne.mis-en-evidence ? Theme.rose : ligne.mention ? Theme.rose.with-alpha(root.actif ? 0.38 : 0.28) : root.actif ? Theme.encre.with-alpha(0.03) : transparent;
    animate background { duration: Mouvement.d-l; easing: Courbes.sortie; }
    accessible-role: text;
    accessible-label: (ligne.systeme ? "Message système" : ligne.auteur) + ", " + ligne.heure;
    accessible-description: ligne.texte-brut;
    if root.ligne.mention: Rectangle {
        x: 0;
        width: 3px;
        background: Theme.rose-fonce;
    }
    function clic-droit(e: PointerEvent, x: length, y: length) {
        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
            portee.focus();
            root.ouvrir-menu(x, y);
        }
    }
    zone := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                portee.focus();
                if (e.button == PointerEventButton.right) {
                    root.ouvrir-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
        portee := FocusScope {
            focus-on-click: false;
            key-pressed(e) => {
                if (e.modifiers.control && (e.text == "c" || e.text == "C")) {
                    root.copier(root.ligne.texte-brut);
                    return accept;
                }
                if (e.text == Key.Menu || (e.modifiers.shift && e.text == Key.F10)) {
                    root.ouvrir-menu(root.absolute-position.x + 72px, root.absolute-position.y + Math.min(root.height, 28px));
                    return accept;
                }
                return reject;
            }
            HorizontalLayout {
                padding-top: root.ligne.suite ? (Affichage.compacte ? 1px : 2px) : root.ligne.systeme || Affichage.compacte ? 6px : 14px;
                padding-bottom: Affichage.compacte ? 1px : 2px;
                padding-right: 24px;
                Rectangle {
                    width: 72px;
                    if !root.ligne.suite && !root.ligne.systeme: Rectangle {
                        x: 22px;
                        y: 0;
                        width: 36px;
                        height: 36px;
                        accessible-role: button;
                        accessible-label: "Profil de " + root.ligne.auteur;
                        accessible-action-default => {
                            DonneesMessagerie.auteur-clique(root.ligne.utilisateur);
                        }
                        Avatar {
                            nom: root.ligne.auteur;
                            initiales: root.ligne.initiales;
                            teinte: root.ligne.teinte;
                            portrait: root.ligne.portrait;
                            taille: 36px;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                DonneesMessagerie.auteur-clique(root.ligne.utilisateur);
                            }
                            pointer-event(e) => {
                                root.clic-droit(e, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                    if root.ligne.suite || root.ligne.systeme: HorizontalLayout {
                        y: 0;
                        height: 20px;
                        padding-right: 14px;
                        spacing: 4px;
                        alignment: end;
                        if root.ligne.epingle: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 13px;
                                height: 13px;
                                accessible-role: image;
                                accessible-label: "Message épinglé";
                                Icone {
                                    nom: "epingle";
                                    taille: 13px;
                                    couleur: Theme.rose-texte;
                                }
                            }
                        }
                        Text {
                            text: root.ligne.heure;
                            color: Theme.gris-2;
                            font-family: Typo.mono;
                            font-size: 11px;
                            vertical-alignment: center;
                            opacity: root.ligne.systeme || root.actif ? 1 : 0;
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    alignment: start;
                    if root.ligne.reponse.presente: EnTeteReponse {
                        reponse: root.ligne.reponse;
                    }
                    if !root.ligne.suite && !root.ligne.systeme: HorizontalLayout {
                        spacing: Espace.e2;
                        height: 20px;
                        auteur := Text {
                            text: root.ligne.auteur;
                            color: root.ligne.a-couleur ? root.ligne.couleur : Theme.encre;
                            font-size: Typo.corps;
                            font-weight: Typo.gras;
                            vertical-alignment: center;
                            overflow: elide;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    DonneesMessagerie.auteur-clique(root.ligne.utilisateur);
                                }
                                pointer-event(e) => {
                                    root.clic-droit(e, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                        if root.ligne.bot: VerticalLayout {
                            alignment: center;
                            BadgeRole {
                                genre: GenreBadgeRole.bot;
                            }
                        }
                        if root.ligne.nombre-badges > 0: VerticalLayout {
                            alignment: center;
                            Medaille {
                                badge: root.ligne.badge-1;
                                taille: 15px;
                            }
                        }
                        if root.ligne.nombre-badges > 1: VerticalLayout {
                            alignment: center;
                            Medaille {
                                badge: root.ligne.badge-2;
                                taille: 15px;
                            }
                        }
                        if root.ligne.epingle: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 13px;
                                height: 13px;
                                accessible-role: image;
                                accessible-label: "Message épinglé";
                                Icone {
                                    nom: "epingle";
                                    taille: 13px;
                                    couleur: Theme.rose-texte;
                                }
                            }
                        }
                        Text {
                            text: root.ligne.heure;
                            color: Theme.gris-2;
                            font-family: Typo.mono;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                    if root.ligne.annexes.sondage.present: HorizontalLayout {
                        SondageVue {
                            horizontal-stretch: 1;
                            preferred-width: 460px;
                            sondage: root.ligne.annexes.sondage;
                            question: root.ligne.blocs;
                            heure: root.ligne.heure;
                            message: root.ligne.id;
                        }
                        Rectangle {
                            horizontal-stretch: 0;
                        }
                    }
                    if root.ligne.blocs.length > 0 && !root.ligne.annexes.sondage.present: TexteRiche {
                        blocs: root.ligne.blocs;
                        taille: root.ligne.systeme ? 14px : Typo.corps;
                        encre: root.ligne.systeme ? Theme.gris : Theme.encre-2;
                        lien(cible) => {
                            DonneesMessagerie.lien-clique(root.ligne.id, cible);
                        }
                    }
                    if root.ligne.annexes.pieces-jointes.length > 0 || root.ligne.annexes.reactions.length > 0 || root.ligne.annexes.lecteurs.length > 0 || root.ligne.annexes.carte.genre != GenreCarte.aucune: AnnexesMessageVue {
                        annexes: root.ligne.annexes;
                        message: root.ligne.id;
                        reagir: root.ligne.droits.reagir;
                    }
                    if root.ligne.etat-envoi != "": HorizontalLayout {
                        spacing: Espace.e3;
                        accessible-role: text;
                        accessible-label: root.ligne.etat-envoi;
                        Text {
                            text: root.ligne.etat-envoi;
                            color: root.ligne.envoi-echec ? Theme.danger : Theme.gris;
                            font-size: Typo.minuscule;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if root.ligne.envoi-echec: LienAction {
                            texte: "Réessayer";
                            clique => {
                                DonneesMessagerie.reessayer-envoi(root.ligne.id);
                            }
                        }
                        if root.ligne.envoi-echec: LienAction {
                            texte: "Supprimer";
                            clique => {
                                DonneesMessagerie.abandonner-envoi(root.ligne.id);
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }
    if !root.ligne.systeme && (root.ligne.droits.menu || root.ligne.texte-brut != ""): BarreActions {
        x: parent.width - self.width - 24px;
        y: -16px;
        ligne: root.ligne;
        visible: root.actif;
        changed survolee => {
            root.sur-barre = self.survolee;
        }
        copier(texte) => {
            root.copier(texte);
        }
        plus(x, haut, bas) => {
            root.a-ouvert-menu = true;
            DonneesMessagerie.menu-message-bouton(root.ligne.id, x, haut, bas);
        }
    }
}

export component LigneMessageVue inherits VerticalLayout {
    in property <LigneMessage> ligne;
    callback copier(string);
    property <int> mesure: DonneesMessagerie.mesure;
    init => {
        DonneesMessagerie.ligne-mesuree(self.ligne.cle, self.height);
    }
    changed mesure => {
        DonneesMessagerie.ligne-mesuree(self.ligne.cle, self.height);
    }
    changed height => {
        DonneesMessagerie.ligne-mesuree(self.ligne.cle, self.height);
    }
    if root.ligne.genre == GenreLigneMessage.debut: Debut { }
    if root.ligne.genre == GenreLigneMessage.chargement: ChargementLigne { }
    if root.ligne.genre == GenreLigneMessage.jour: Separateur {
        texte: root.ligne.libelle;
    }
    if root.ligne.genre == GenreLigneMessage.nouveau: Separateur {
        texte: root.ligne.libelle;
        accent: true;
    }
    if root.ligne.genre == GenreLigneMessage.message: CorpsMessage {
        ligne: root.ligne;
        copier(texte) => {
            root.copier(texte);
        }
    }
}
