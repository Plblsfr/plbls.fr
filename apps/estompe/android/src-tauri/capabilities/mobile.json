{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Permissions de la fenêtre principale sur Android et iOS : pas de mises à jour intégrées (nouvel APK) ni de raccourci global.",
  "windows": [
    "main"
  ],
  "platforms": [
    "android",
    "iOS"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://**"
        },
        {
          "url": "http://**"
        },
        {
          "url": "mailto:*"
        },
        {
          "url": "tel:*"
        }
      ]
    }
  ]
}
