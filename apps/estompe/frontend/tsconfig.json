{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "types": ["svelte", "vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "allowJs": true,
    "checkJs": false,
    "verbatimModuleSyntax": true,
    "paths": {
      "@platform": ["../web/src/platform.ts"],
      "svelte": ["./node_modules/svelte", "../../../node_modules/svelte"], "svelte/*": ["./node_modules/svelte/*", "../../../node_modules/svelte/*"],
      "vitest": ["./node_modules/vitest", "../../../node_modules/vitest"], "@tauri-apps/*": ["./node_modules/@tauri-apps/*", "../../../node_modules/@tauri-apps/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "../web/src/**/*", "../windows/src/**/*", "../android/src/**/*", "../crates/core/ts/**/*"]
}
