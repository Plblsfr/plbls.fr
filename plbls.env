# Configuration de production non secrète de tous les services, copiée dans chaque image au build (/etc/plbls.env).
# Une variable de l'environnement du conteneur (onglet Environment de Dokploy, deploy/.env.example) l'emporte sur ce fichier.
# Format : CLE=valeur, une par ligne, sans guillemets ni interpolation. Secrets interdits : ils sont dans Vault (deploy/**/.env.example).
# Dev : deploy/dev.env. Détail : deploy/README.md.

# ── Communes ─────────────────────────────────────────────────────────────────────────────────────────────────────
# Serveur PostgreSQL partagé (plbls.fr-infra, réseau postgres-net) : un seul utilisateur pour toutes les bases ;
# chaque service rejoint la base de son nom (aegis, entracte, estompe, sillon). Mot de passe : DATABASE_PASSWORD.
DATABASE_URL=postgres://postgres-main:5432
DATABASE_USER=plbls
# Redis partagé (service redis du compose) : sessions du gateway, cache et invalidations d'aegis. Mot de passe : REDIS_PASSWORD.
REDIS_URL=redis://redis:6379
# Gateway public (connexion, GET /auth/me vu des navigateurs) et le même par le réseau Docker (appels de serveur à serveur)
GATEWAY_URL=https://security.plbls.fr
GATEWAY_INTERNE_URL=http://auth-gateway:8080
# Service de droits d'Estompe, d'Entracte, de Sillon et de Régie
AEGIS_URL=http://aegis:8080
# Rôle Keycloak qui ouvre l'administration d'aegis (lu par aegis et par Estompe)
AEGIS_ADMIN_ROLE=aegis-admin
AEGIS_REDIS_PREFIX=aegis
# API d'Entracte jointe de serveur à serveur (salon cinéma d'Estompe) ; vide = pas de salon cinéma
ENTRACTE_INTERNE_URL=http://entracte-api:8080
# API de Sillon jointe de serveur à serveur (cartes de liens Sillon d'Estompe) ; vide = pas de carte
SILLON_INTERNE_URL=http://sillon-api:8080
# Notifications push d'Estompe et d'Entracte (un navigateur n'a qu'un abonnement push par application)
VAPID_SUBJECT=mailto:admin@plbls.fr

# ── security (auth-gateway) ──────────────────────────────────────────────────────────────────────────────────────
# Routes embarquées dans l'image ; défauts : api/security/config/default.toml (GATEWAY__<SECTION>__<CLE>)
GATEWAY_CONFIG=/app/config/routes
# URL publique du realm, exactement l'`iss` des tokens (= KC_HOSTNAME de Keycloak), puis le même realm par le réseau Docker
GATEWAY__OIDC__ISSUER=https://auth.plbls.fr/realms/default
GATEWAY__OIDC__INTERNAL_ISSUER=http://keycloak:8080/realms/default
GATEWAY__INTERNAL__MAX_PAGE_SIZE=100

# ── aegis ────────────────────────────────────────────────────────────────────────────────────────────────────────
# Hôtes que aegis peut appeler pour lister les ressources des services, séparés par des virgules ;
# vide = aucun (un manifeste qui déclare un list_url est refusé). Défauts : api/aegis/config/default.toml (AEGIS__<SECTION>__<CLE>)
AEGIS__RESSOURCES__ALLOWED_HOSTS=estompe-api

# ── Entracte (entracte-api) ──────────────────────────────────────────────────────────────────────────────────────
ENTRACTE_PORT=8080
# Origines des fronts (CORS, CSRF) ; https://tauri.localhost = app Windows, http://tauri.localhost = Android
ENTRACTE_ALLOWED_ORIGINS=https://estompe.plbls.fr,https://tauri.localhost,http://tauri.localhost
# Radarr et Sonarr (stack média) ; profil de qualité et dossier racine des demandes acceptées (vides = les premiers déclarés)
ENTRACTE_RADARR_URL=http://radarr:7878
ENTRACTE_RADARR_QUALITY_PROFILE=
ENTRACTE_RADARR_ROOT_FOLDER=
ENTRACTE_SONARR_URL=http://sonarr:8989
ENTRACTE_SONARR_QUALITY_PROFILE=
ENTRACTE_SONARR_ROOT_FOLDER=
# Dossier des médias, monté en lecture seule au même chemin (le compose lit sa propre valeur : la changer dans l'onglet Dokploy)
ENTRACTE_MEDIAS=/srv/medias
# Chemins vus par Radarr/Sonarr = chemins dans ce conteneur, sauf correspondances « distant=local » séparées par des virgules
ENTRACTE_CHEMINS=
# Synchronisation périodique du catalogue en minutes (0 = webhooks et bouton d'administration seulement)
ENTRACTE_SYNC_MINUTES=15
ENTRACTE_TMDB_URL=https://api.themoviedb.org
ENTRACTE_TMDB_IMAGES_URL=https://image.tmdb.org
ENTRACTE_LANGUE=fr-FR
# Lecture : ffmpeg et ffprobe de l'image, dossier temporaire (volume entracte-transcodage) et sa taille maximale en Go
ENTRACTE_FFMPEG=ffmpeg
ENTRACTE_FFPROBE=ffprobe
ENTRACTE_TRANSCODE_DIR=/tmp/entracte
ENTRACTE_TRANSCODE_MAX_GO=20
# Transcodage : cpu, vaapi, qsv ou nvenc ; périphérique (vaapi, qsv). Mode inutilisable = repli sur le CPU
ENTRACTE_TRANSCODE_MODE=cpu
ENTRACTE_TRANSCODE_DEVICE=/dev/dri/renderD128
# Lectures simultanées par personne, transcodages simultanés au total, inactivité avant l'arrêt d'un flux (secondes)
ENTRACTE_MAX_FLUX=2
ENTRACTE_MAX_TRANSCODAGES=2
ENTRACTE_INACTIVITE_SECONDES=300
# Intros (docs/entracte/README.md, « Intros ») : secondes d'audio analysées par épisode, durées minimale et maximale d'une intro
ENTRACTE_INTRO_ANALYSE_SECONDES=600
ENTRACTE_INTRO_MIN_SECONDES=15
ENTRACTE_INTRO_MAX_SECONDES=120
# Bits de différence tolérés entre deux points d'empreinte (0 à 32), trou toléré dans une suite (secondes)
ENTRACTE_INTRO_BITS=8
ENTRACTE_INTRO_TROU_SECONDES=3
# Part des paires d'un épisode qui doivent s'accorder (0 à 1), écart toléré entre leurs bornes (secondes)
ENTRACTE_INTRO_CONSENSUS=0.6
ENTRACTE_INTRO_TOLERANCE_SECONDES=5
# Priorité de l'extraction des empreintes (nice, 0 à 19 ; 0 = priorité normale) ; fpcalc sert si ffmpeg n'a pas le muxer chromaprint
ENTRACTE_INTRO_NICE=19
ENTRACTE_FPCALC=fpcalc

# ── Sillon (sillon-api) ──────────────────────────────────────────────────────────────────────────────────────────
SILLON_PORT=8080
# Origines des fronts (CORS, CSRF) ; https://tauri.localhost = app Windows, http://tauri.localhost = Android
SILLON_ALLOWED_ORIGINS=https://estompe.plbls.fr,https://tauri.localhost,http://tauri.localhost
# Lidarr (stack média)
SILLON_LIDARR_URL=http://lidarr:8686
# Dossier de la musique, monté en lecture seule au même chemin (le compose lit sa propre valeur : la changer dans l'onglet Dokploy)
SILLON_MEDIAS=/srv/musique
# Chemins vus par Lidarr = chemins dans ce conteneur, sauf correspondances « distant=local » séparées par des virgules
SILLON_CHEMINS=
# Synchronisation périodique du catalogue en minutes (0 = webhook et bouton d'administration seulement)
SILLON_SYNC_MINUTES=15
# ffprobe de l'image (codec, débit, fréquence, canaux, durée des fichiers)
SILLON_FFPROBE=ffprobe
# Lecture : ffmpeg de l'image (transcodage Opus/AAC, mesure du volume EBU R128), cache des fichiers transcodés (volume sillon-cache,
# plafond en Go, éviction du moins récemment lu) et transcodages simultanés au plus (au-delà : 503 server_busy)
SILLON_FFMPEG=ffmpeg
SILLON_CACHE=/tmp/sillon
SILLON_CACHE_GO=10
SILLON_MAX_TRANSCODAGES=2
# Ajout de musique : surcharges facultatives du dossier racine et des identifiants des profils de qualité et de métadonnées de Lidarr ;
# vides = ceux que Lidarr annonce (dossier racine le plus utilisé, profils par défaut de ce dossier)
SILLON_LIDARR_RACINE=
SILLON_LIDARR_QUALITE=
SILLON_LIDARR_METADONNEES=
# Ajouts par personne sur 24 heures glissantes ; plafond du dossier de la musique en Go (0 = sans plafond) ; délai avant « échec » sans résultat (heures)
SILLON_AJOUTS_PAR_JOUR=10
SILLON_MEDIAS_GO=500
SILLON_AJOUTS_DELAI_HEURES=72
# Analyse audio des pistes en tâche de fond : analyses simultanées (0 = pas d'analyse), en pause pendant un transcodage
SILLON_ANALYSE_PARALLELE=1
# Recommandation : poids du score (vide = valeurs par défaut ; « audio=1,metadonnees=0.6,similarite=0.5,affinite=1,decouverte=2,sauts=1.5,
# piste_recente=1,artiste_recent=0.4 »), jours avant de reproposer une suggestion sautée
SILLON_RECO_POIDS=
SILLON_SUGGESTION_DELAI_JOURS=14
# ListenBrainz (artistes similaires, enregistrements populaires) : API (« off » = coupé, donc pas de découverte), API « labs »,
# intervalle minimal entre deux appels (ms), jours avant de relire un résultat gardé en base
SILLON_LISTENBRAINZ_URL=https://api.listenbrainz.org
SILLON_LISTENBRAINZ_LABS_URL=https://labs.api.listenbrainz.org
SILLON_LISTENBRAINZ_INTERVALLE_MS=1000
SILLON_SIMILARITE_JOURS=30
# Découverte (téléchargement d'albums de titres absents pendant l'aléatoire avec suggestions) : interrupteur, budget en Go pris sur
# SILLON_MEDIAS_GO, albums par personne et par jour, jours sans écoute complète avant de proposer la suppression
SILLON_DECOUVERTE=true
SILLON_DECOUVERTE_GO=20
SILLON_DECOUVERTE_PAR_JOUR=2
SILLON_DECOUVERTE_ESSAI_JOURS=30

# ── Régie (regie-api) ─────────────────────────────────────────────────────────────────────────────────────────────
REGIE_PORT=8080
# Origines des fronts (CORS, CSRF) ; https://tauri.localhost = app Windows, http://tauri.localhost = Android
REGIE_ALLOWED_ORIGINS=https://estompe.plbls.fr,https://tauri.localhost,http://tauri.localhost
# Services de la stack média, joints par le réseau MEDIAS_NETWORK ; une URL vide ou sans clé = service non configuré
REGIE_RADARR_URL=http://radarr:7878
REGIE_SONARR_URL=http://sonarr:8989
REGIE_LIDARR_URL=http://lidarr:8686
REGIE_PROWLARR_URL=http://prowlarr:9696
# Interface web de qBittorrent, jointe avec la clé d'API REGIE_QBITTORRENT_CLE (qBittorrent 5.2 ou plus récent) ;
# sans clé, compte de l'interface web (mot de passe : REGIE_QBITTORRENT_MOT_DE_PASSE)
REGIE_QBITTORRENT_URL=http://qbittorrent:8080
REGIE_QBITTORRENT_UTILISATEUR=admin
# Dépôts (un .torrent et ses fichiers envoyés depuis l'app) : dossier monté en écriture au même chemin (le compose lit sa propre
# valeur : la changer dans l'onglet Dokploy), sur le même système de fichiers que les bibliothèques pour les liens physiques ;
# le même dossier vu par qBittorrent et par Radarr, Sonarr, Lidarr s'ils le montent ailleurs (vide = même chemin) ; plafond en Go
REGIE_DEPOTS=/srv/medias/depots
REGIE_DEPOTS_QBITTORRENT=
REGIE_DEPOTS_ARR=
REGIE_DEPOTS_GO=200
# Intervalle de relecture de qBittorrent pendant qu'un écran suit les téléchargements, en millisecondes (500 au moins)
REGIE_SUIVI_MS=1500

# ── Estompe (estompe-api, estompe-web) ───────────────────────────────────────────────────────────────────────────
# Front (estompe-web au démarrage, apps Windows et Android au build) : URL publiques de l'API, de LiveKit, d'Entracte, de Sillon et de Régie (vide = pas de section films et séries, musique, ou administration des médias)
API_URL=https://chat.plbls.fr
VOICE_URL=wss://voice.plbls.fr
KEYCLOAK_ISSUER=https://auth.plbls.fr/realms/default
ENTRACTE_PUBLIC_URL=https://entracte-api.plbls.fr
SILLON_PUBLIC_URL=https://sillon-api.plbls.fr
REGIE_PUBLIC_URL=https://regie-api.plbls.fr
# Origines des fronts (CORS, CSRF, WebSocket) ; https://tauri.localhost = app Windows
ALLOWED_ORIGINS=https://estompe.plbls.fr,https://tauri.localhost
# Adresse par laquelle aegis joint cette API
AEGIS_RESOURCES_URL=http://estompe-api:8080
# Fichiers (volume estompe-data) : total, quota par utilisateur, taille d'une vidéo (comptée dans les quotas)
MAX_STORAGE_GB=20
MAX_USER_STORAGE_MB=2048
MAX_VIDEO_SIZE_MB=100
# LiveKit : URL publique vue par les clients et nom de la clé d'API (le service livekit du compose déclare la même)
LIVEKIT_URL=wss://voice.plbls.fr
LIVEKIT_API_KEY=estompe
# Caméra et partage d'écran ; plafonds du partage annoncés aux clients (vides = 60 images/s, 2160 px)
LIVEKIT_ALLOW_VIDEO=true
VOICE_MAX_SCREEN_FPS=
VOICE_MAX_SCREEN_HEIGHT=
# Blocs : BLOCK_<NOM>=false retire le bloc et ses routes (regarder-ensemble, draw2gether et transcription dépendent de vocal)
BLOCK_GIFS=true
BLOCK_MUSIQUE=true
BLOCK_VOCAL=true
BLOCK_REGARDER_ENSEMBLE=true
BLOCK_DRAW2GETHER=true
BLOCK_TRANSCRIPTION=true
BLOCK_VIDEOS=true
BLOCK_APERCU_LIENS=true
BLOCK_NOTIFICATIONS=true
BLOCK_EMOJIS=true
BLOCK_AVATARS=true
BLOCK_BADGES=true
BLOCK_SIGNALEMENTS=true
BLOCK_ACTIVITE_STATUT=true
# Transcription des messages vocaux (service transcribe) ; langue vide = détection automatique ;
# TRANSCRIBE_ALPHA=true : réservée aux fonctions alpha débloquées
TRANSCRIBE_URL=http://transcribe:8000
TRANSCRIBE_MODEL=Systran/faster-whisper-small
TRANSCRIBE_LANGUAGE=
TRANSCRIBE_ALPHA=true
