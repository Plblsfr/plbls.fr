# Configuration de production non secrète de tous les services, copiée dans chaque image au build (/etc/plbls.env).
# Une variable de l'environnement du conteneur (onglet Environment de Dokploy, deploy/.env.example) l'emporte sur ce fichier.
# Format : CLE=valeur, une par ligne, sans guillemets ni interpolation. Secrets interdits : ils sont dans Vault (deploy/**/.env.example).
# Dev : deploy/dev.env. Détail : deploy/README.md.

# ── Communes ─────────────────────────────────────────────────────────────────────────────────────────────────────
# Serveur PostgreSQL partagé (plbls.fr-infra, réseau postgres-net) : un seul utilisateur pour toutes les bases ;
# chaque service rejoint la base de son nom (aegis, entracte, estompe). Mot de passe : DATABASE_PASSWORD.
DATABASE_URL=postgres://postgres-main:5432
DATABASE_USER=plbls
# Redis partagé (service redis du compose) : sessions du gateway, cache et invalidations d'aegis. Mot de passe : REDIS_PASSWORD.
REDIS_URL=redis://redis:6379
# Gateway public (connexion, GET /auth/me vu des navigateurs) et le même par le réseau Docker (appels de serveur à serveur)
GATEWAY_URL=https://security.plbls.fr
GATEWAY_INTERNE_URL=http://auth-gateway:8080
# Service de droits d'Estompe et d'Entracte
AEGIS_URL=http://aegis:8080
# Rôle Keycloak qui ouvre l'administration d'aegis (lu par aegis et par Estompe)
AEGIS_ADMIN_ROLE=aegis-admin
AEGIS_REDIS_PREFIX=aegis
# API d'Entracte jointe de serveur à serveur (salon cinéma d'Estompe) ; vide = pas de salon cinéma
ENTRACTE_INTERNE_URL=
# Notifications push d'Estompe et d'Entracte (un navigateur n'a qu'un abonnement push par application)
VAPID_SUBJECT=mailto:admin@plbls.fr

# ── security (auth-gateway) ──────────────────────────────────────────────────────────────────────────────────────
# Routes embarquées dans l'image ; défauts : api/security/config/default.toml (GATEWAY__<SECTION>__<CLE>)
GATEWAY_CONFIG=/app/config/routes
# URL publique du realm, exactement l'`iss` des tokens (= KC_HOSTNAME de Keycloak), puis le même realm par le réseau Docker
GATEWAY__OIDC__ISSUER=https://auth.plbls.fr/realms/default
GATEWAY__OIDC__INTERNAL_ISSUER=http://keycloak:8080/realms/default
GATEWAY__INTERNAL__MAX_PAGE_SIZE=100

# ── aegis ────────────────────────────────────────────────────────────────────────────────────────────────────────
# Hôtes que aegis peut appeler pour lister les ressources des services, séparés par des virgules ;
# vide = aucun (un manifeste qui déclare un list_url est refusé). Défauts : api/aegis/config/default.toml (AEGIS__<SECTION>__<CLE>)
AEGIS__RESSOURCES__ALLOWED_HOSTS=estompe-api

# ── Entracte (entracte-api) ──────────────────────────────────────────────────────────────────────────────────────
ENTRACTE_PORT=8080
# Origines des fronts (CORS, CSRF) ; https://tauri.localhost = app Windows, http://tauri.localhost = Android
ENTRACTE_ALLOWED_ORIGINS=https://estompe.plbls.fr,https://tauri.localhost,http://tauri.localhost
# Radarr et Sonarr (stack média) ; profil de qualité et dossier racine des demandes acceptées (vides = les premiers déclarés)
ENTRACTE_RADARR_URL=http://radarr:7878
ENTRACTE_RADARR_QUALITY_PROFILE=
ENTRACTE_RADARR_ROOT_FOLDER=
ENTRACTE_SONARR_URL=http://sonarr:8989
ENTRACTE_SONARR_QUALITY_PROFILE=
ENTRACTE_SONARR_ROOT_FOLDER=
# Dossier des médias, monté en lecture seule au même chemin (le compose lit sa propre valeur : la changer dans l'onglet Dokploy)
ENTRACTE_MEDIAS=/srv/medias
# Chemins vus par Radarr/Sonarr = chemins dans ce conteneur, sauf correspondances « distant=local » séparées par des virgules
ENTRACTE_CHEMINS=
# Synchronisation périodique du catalogue en minutes (0 = webhooks et bouton d'administration seulement)
ENTRACTE_SYNC_MINUTES=15
ENTRACTE_TMDB_URL=https://api.themoviedb.org
ENTRACTE_TMDB_IMAGES_URL=https://image.tmdb.org
ENTRACTE_LANGUE=fr-FR
# Lecture : ffmpeg et ffprobe de l'image, dossier temporaire (volume entracte-transcodage) et sa taille maximale en Go
ENTRACTE_FFMPEG=ffmpeg
ENTRACTE_FFPROBE=ffprobe
ENTRACTE_TRANSCODE_DIR=/tmp/entracte
ENTRACTE_TRANSCODE_MAX_GO=20
# Transcodage : cpu, vaapi, qsv ou nvenc ; périphérique (vaapi, qsv). Mode inutilisable = repli sur le CPU
ENTRACTE_TRANSCODE_MODE=cpu
ENTRACTE_TRANSCODE_DEVICE=/dev/dri/renderD128
# Lectures simultanées par personne, transcodages simultanés au total, inactivité avant l'arrêt d'un flux (secondes)
ENTRACTE_MAX_FLUX=2
ENTRACTE_MAX_TRANSCODAGES=2
ENTRACTE_INACTIVITE_SECONDES=300

# ── Estompe (estompe-api, estompe-web) ───────────────────────────────────────────────────────────────────────────
# Front (estompe-web) : URL publiques de l'API, de LiveKit et d'Entracte vues par le navigateur (vide = pas de section films et séries)
API_URL=https://chat.plbls.fr
VOICE_URL=wss://voice.plbls.fr
KEYCLOAK_ISSUER=
ENTRACTE_PUBLIC_URL=
# Origines des fronts (CORS, CSRF, WebSocket) ; https://tauri.localhost = app Windows
ALLOWED_ORIGINS=https://estompe.plbls.fr,https://tauri.localhost
# Adresse par laquelle aegis joint cette API
AEGIS_RESOURCES_URL=http://estompe-api:8080
# Fichiers (volume estompe-data) : total, quota par utilisateur, taille d'une vidéo (comptée dans les quotas)
MAX_STORAGE_GB=20
MAX_USER_STORAGE_MB=2048
MAX_VIDEO_SIZE_MB=100
# LiveKit : URL publique vue par les clients et nom de la clé d'API (le service livekit du compose déclare la même)
LIVEKIT_URL=wss://voice.plbls.fr
LIVEKIT_API_KEY=estompe
# Caméra et partage d'écran ; plafonds du partage annoncés aux clients (vides = 60 images/s, 2160 px)
LIVEKIT_ALLOW_VIDEO=true
VOICE_MAX_SCREEN_FPS=
VOICE_MAX_SCREEN_HEIGHT=
# Blocs : BLOCK_<NOM>=false retire le bloc et ses routes (regarder-ensemble, draw2gether et transcription dépendent de vocal)
BLOCK_GIFS=true
BLOCK_MUSIQUE=true
BLOCK_VOCAL=true
BLOCK_REGARDER_ENSEMBLE=true
BLOCK_DRAW2GETHER=true
BLOCK_TRANSCRIPTION=true
BLOCK_VIDEOS=true
BLOCK_APERCU_LIENS=true
BLOCK_NOTIFICATIONS=true
BLOCK_EMOJIS=true
BLOCK_AVATARS=true
BLOCK_BADGES=true
BLOCK_SIGNALEMENTS=true
BLOCK_ACTIVITE_STATUT=true
# Transcription des messages vocaux (service transcribe) ; langue vide = détection automatique ;
# TRANSCRIBE_ALPHA=true : réservée aux fonctions alpha débloquées
TRANSCRIBE_URL=http://transcribe:8000
TRANSCRIBE_MODEL=Systran/faster-whisper-small
TRANSCRIBE_LANGUAGE=
TRANSCRIBE_ALPHA=true
