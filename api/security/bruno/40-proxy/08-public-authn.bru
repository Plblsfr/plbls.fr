meta {
  name: route publique avec cookie : identité injectée
  type: http
  seq: 8
}

get {
  url: {{gw}}/api/whoami/x
  body: none
  auth: none
}

headers {
  Cookie: plbls_sid={{sid}}
}

script:pre-request {
  req.setMaxRedirects(0);

}

tests {
  test("identité présente", function () { expect(res.body).to.contain("X-User-Name: demo"); });
}
