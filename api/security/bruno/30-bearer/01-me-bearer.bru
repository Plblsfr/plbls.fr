meta {
  name: GET /auth/me (Bearer demo)
  type: http
  seq: 1
}

get {
  url: {{gw}}/auth/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{tokDemo}}
}

script:pre-request {
  req.setMaxRedirects(0);

}

tests {
  test("identité du token", function () {
    expect(res.status).to.equal(200);
    expect(res.body.name).to.equal("demo");
    expect(res.body.client).to.equal("plbls-mobile");
    expect(res.body.roles).to.include("user");
    expect(res.body.roles).to.include("plbls-mobile:scanner");
  });
}
