meta {
  name: POST /mcp avec un token Keycloak : 401
  type: http
  seq: 3
}

post {
  url: {{gw}}/mcp
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{tokAdmin}}
  Content-Type: application/json
}

body:json {
  {"jsonrpc":"2.0","id":1,"method":"ping"}
}

script:pre-request {
  req.setMaxRedirects(0);

}

tests {
  test("401 : seul le token MCP est accepté", function () { expect(res.status).to.equal(401); });
}
