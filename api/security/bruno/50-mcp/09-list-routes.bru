meta {
  name: MCP list_routes
  type: http
  seq: 9
}

post {
  url: {{gw}}/mcp
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{mcpToken}}
  Content-Type: application/json
  Accept: application/json, text/event-stream
}

body:json {
  {"jsonrpc":"2.0","id":5,"method":"tools/call","params":{"name":"list_routes"}}
}

script:pre-request {
  req.setMaxRedirects(0);

}

tests {
  test("routes sans upstream", function () {
    const t = res.body.result.content[0].text;
    expect(t).to.contain("/api/admin");
    expect(t).to.contain("http://localhost:8080/api/private");
    expect(t).to.not.contain("8081");
  });
}
