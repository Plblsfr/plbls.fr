{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.js",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.ts",
      "**/*.css",
      "**/*.json",
      "**/*.jsonc",
      "!**/vendor/plbls-ui",
      "!**/src-tauri/gen",
      "!**/package-lock.json",
      "!web/estompe/public/mediapipe"
    ]
  },
  "formatter": {
    "enabled": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "domains": {
      "playwright": "none"
    },
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "noDescendingSpecificity": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "useIterableCallbackReturn": "off",
        "noAssignInExpressions": "off"
      },
      "complexity": {
        "noImportantStyles": "off",
        "useArrowFunction": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/e2e/**"
      ],
      "linter": {
        "domains": {
          "playwright": "recommended"
        },
        "rules": {
          "performance": {
            "useDomNodeTextContent": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.js",
        "**/*.test.mjs"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noConstructorReturn": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": false
  }
}
