{
  "name": "plbls-fr",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26"
  },
  "workspaces": [
    "packages/ui",
    "packages/deepmerge",
    "web/estompe",
    "web/pli"
  ],
  "scripts": {
    "lint": "biome ci .",
    "check": "node scripts/check-node.mjs && node scripts/sync-ui.mjs --check && npm run check --workspaces",
    "test": "node --test \"scripts/*.test.mjs\" && npm run test --workspaces",
    "build": "npm run build --workspaces",
    "ui:sync": "node scripts/sync-ui.mjs",
    "ui:check": "node scripts/sync-ui.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4"
  },
  "overrides": {
    "glob": "^14.0.4"
  }
}
