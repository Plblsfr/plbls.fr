# Régie (regie-api). Secrets : secret/regie de Vault. Valeurs non secrètes : plbls.env ; communes (gateway) : deploy/.env.example.
# Domaine Dokploy : regie-api port 8080 (regie-api.plbls.fr). Détail : docs/regie/README.md.

# Jeton « regie » chez aegis ; sans lui, la permission est refusée
AEGIS_TOKEN_REGIE=${{vault.plbls.regie:AEGIS_TOKEN_REGIE}}
# Clés d'API (Settings > General de chaque service) ; vide = service non configuré
REGIE_RADARR_CLE=${{vault.plbls.regie:REGIE_RADARR_CLE}}
REGIE_SONARR_CLE=${{vault.plbls.regie:REGIE_SONARR_CLE}}
REGIE_LIDARR_CLE=${{vault.plbls.regie:REGIE_LIDARR_CLE}}
REGIE_PROWLARR_CLE=${{vault.plbls.regie:REGIE_PROWLARR_CLE}}
# Clé d'API de qBittorrent 5.2 ou plus récent (Préférences > WebUI > API Key, commence par qbt_)
REGIE_QBITTORRENT_CLE=${{vault.plbls.regie:REGIE_QBITTORRENT_CLE}}
# qBittorrent plus ancien, sans clé d'API : mot de passe du compte REGIE_QBITTORRENT_UTILISATEUR (plbls.env) ; ignoré quand la clé est donnée
REGIE_QBITTORRENT_MOT_DE_PASSE=
