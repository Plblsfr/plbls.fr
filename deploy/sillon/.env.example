# Sillon (sillon-api). Secrets : secret/sillon de Vault. Valeurs non secrètes : plbls.env ; communes (base, gateway) : deploy/.env.example.
# Domaine Dokploy : sillon-api port 8080 (sillon-api.plbls.fr). Détail : docs/sillon/README.md.

# Jeton « sillon » chez aegis ; sans lui, toutes les permissions sont refusées
AEGIS_TOKEN_SILLON=${{vault.plbls.sillon:AEGIS_TOKEN_SILLON}}
# Jeton du webhook Lidarr : mot de passe du webhook (Basic auth, nom libre), Bearer ou …?token=… ; vide = webhook coupé
SILLON_WEBHOOK_TOKEN=${{vault.plbls.sillon:SILLON_WEBHOOK_TOKEN}}
# Clé d'API de Lidarr (Settings > General) ; vide = pas de catalogue
SILLON_LIDARR_CLE=${{vault.plbls.sillon:SILLON_LIDARR_CLE}}
