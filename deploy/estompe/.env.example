# Estompe (estompe-api, estompe-web, estompe-postgres, estompe-backup, livekit). Secrets : secret/estompe de Vault.
# Seul estompe-api lit tout le .env ; estompe-web, estompe-postgres, estompe-backup et livekit ne reçoivent que les variables nommées
# dans leur section environment du compose (front, POSTGRES_*, BACKUP_*, LIVEKIT_KEYS).
# GATEWAY_URL, PERMISSION_URL et AEGIS_URL : deploy/.env.example. Aussi passé tel quel à l'image de l'API par la CI (ci.yml).
# Domaines Dokploy : estompe-web port 8080 (estompe.plbls.fr), estompe-api port 8080 (chat.plbls.fr), livekit port 7880 (voice.plbls.fr).
# Ports à ouvrir sur le VPS : 7881/tcp et 50000-50100/udp (WebRTC).

# Base (service estompe-postgres) : POSTGRES_* créent la base au premier démarrage, DATABASE_URL la rejoint
POSTGRES_DB=estompe
POSTGRES_USER=estompe
POSTGRES_PASSWORD=${{vault.plbls.estompe:POSTGRES_PASSWORD}}
# postgres://estompe:<POSTGRES_PASSWORD>@estompe-postgres:5432/estompe?sslmode=disable
DATABASE_URL=${{vault.plbls.estompe:DATABASE_URL}}

# Sauvegarde quotidienne (service estompe-backup, voir docs/estompe/BACKUP.md)
BACKUP_HOUR=03
BACKUP_KEEP=14
BACKUP_FILES=false

# Front (estompe-web) : URL publiques de l'API, du gateway et de LiveKit vues par le navigateur
API_URL=https://chat.plbls.fr
VOICE_URL=wss://voice.plbls.fr
KEYCLOAK_ISSUER=
# URL publique de l'API d'Entracte (section films et séries de l'app) : vide = pas de section films et séries ; voir docs/entracte/README.md
ENTRACTE_PUBLIC_URL=

# Origines des fronts (CORS, CSRF, WebSocket), séparées par des virgules ; https://tauri.localhost = app Windows
ALLOWED_ORIGINS=https://estompe.plbls.fr,https://tauri.localhost

# Droits par permission : PERMISSION_TOKEN = jeton « estompe » de PERMISSION__SERVICES__TOKENS ;
# PERMISSION_ADMIN_ROLE ouvre Administration › permissions (le même que server.admin_role de permission)
PERMISSION_TOKEN=${{vault.plbls.estompe:PERMISSION_TOKEN}}
PERMISSION_NAME=estompe:access
PERMISSION_ADMIN_ROLE=permission-admin
# Droits par aegis (AEGIS_URL renseignée) : AEGIS_TOKEN = jeton « estompe » de AEGIS__SERVICES__TOKENS (champ AEGIS_TOKEN de Vault) ;
# AEGIS_REDIS_URL (référence Vault au champ AEGIS__REDIS__URL de secret/aegis, URL avec le mot de passe) = invalidations, droits retirés appliqués tout de suite ;
# AEGIS_RESOURCES_URL = adresse par laquelle aegis joint cette API
AEGIS_TOKEN=
AEGIS_REDIS_URL=
AEGIS_REDIS_PREFIX=aegis
AEGIS_ADMIN_ROLE=aegis-admin
AEGIS_RESOURCES_URL=http://estompe-api:8080

# Fichiers (volume estompe-data) : au-delà du total, les envois sont refusés ; quota par utilisateur ; taille d'une vidéo (comptée dans les quotas)
MAX_STORAGE_GB=20
MAX_USER_STORAGE_MB=2048
MAX_VIDEO_SIZE_MB=100

# LiveKit : URL publique (wss://) vue par les clients, clé et secret (32 caractères au moins) de l'API.
# LIVEKIT_KEYS est lu par le service livekit : « estompe: <LIVEKIT_API_SECRET> » (la clé reste « estompe », webhook du compose).
LIVEKIT_URL=wss://voice.plbls.fr
LIVEKIT_API_KEY=estompe
LIVEKIT_API_SECRET=${{vault.plbls.estompe:LIVEKIT_API_SECRET}}
LIVEKIT_KEYS=${{vault.plbls.estompe:LIVEKIT_KEYS}}
# Caméra et partage d'écran ; plafonds du partage annoncés aux clients (vides = 60 images/s, 2160 px)
LIVEKIT_ALLOW_VIDEO=true
VOICE_MAX_SCREEN_FPS=
VOICE_MAX_SCREEN_HEIGHT=

# Secrets facultatifs ci-dessous : vides = fonction coupée. Pour en activer un, mettre sa référence Vault, comme pour PERMISSION_TOKEN
# (une référence vers un champ absent de Vault fait échouer le déploiement).

# Blocs : BLOCK_<NOM>=false retire le bloc et ses routes. Un bloc actif dont une dépendance est coupée fait échouer le démarrage
# (regarder-ensemble, draw2gether et transcription dépendent de vocal).
BLOCK_GIFS=true
BLOCK_MUSIQUE=true
BLOCK_VOCAL=true
BLOCK_REGARDER_ENSEMBLE=true
BLOCK_DRAW2GETHER=true
BLOCK_TRANSCRIPTION=true
BLOCK_VIDEOS=true
BLOCK_APERCU_LIENS=true
BLOCK_NOTIFICATIONS=true
BLOCK_EMOJIS=true
BLOCK_AVATARS=true
BLOCK_BADGES=true
BLOCK_SIGNALEMENTS=true
BLOCK_ACTIVITE_STATUT=true

# Notifications push (facultatif) : clés VAPID générées une fois par « docker run --rm ghcr.io/plblsfr/estompe vapid » ;
# FCM_SERVICE_ACCOUNT = JSON du compte de service Firebase en base64 (base64 -w0 cle.json) pour l'app Android
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@plbls.fr
FCM_SERVICE_ACCOUNT=

# GIF (Giphy) et Music2gether (YouTube Data v3) ; vides = recherche de GIF coupée, morceaux seuls sans albums ni playlists
GIPHY_API_KEY=
YOUTUBE_API_KEY=

# Transcription des messages vocaux (service transcribe) ; URL vide = coupée, langue vide = détection automatique.
# TRANSCRIBE_ALPHA=true : réservée aux fonctions alpha débloquées ; false : ouverte à tous.
TRANSCRIBE_URL=http://transcribe:8000
TRANSCRIBE_MODEL=Systran/faster-whisper-small
TRANSCRIBE_LANGUAGE=
TRANSCRIBE_ALPHA=true

# Entracte (salon cinéma) : API jointe de serveur à serveur et jeton partagé (ENTRACTE_SERVICE_TOKEN d'Entracte) ;
# vides = pas de salon cinéma. Voir docs/entracte/README.md.
ESTOMPE_ENTRACTE_URL=
ESTOMPE_ENTRACTE_TOKEN=

# Supervision : Bearer de GET /metrics (format Prometheus) ; vide = route coupée (docs/estompe/MONITORING.md)
METRICS_TOKEN=
