# Variables à saisir dans Dokploy (onglet Environment de la stack).

# Images construites par la CI ; à changer pour épingler une version (ex. :v0.1.0 ou :sha-abc1234)
ESTOMPE_IMAGE=ghcr.io/plblsfr/estompe:latest
ESTOMPE_WEB_IMAGE=ghcr.io/plblsfr/estompe-web:latest

# URL publique de l'API vue par le navigateur (domaine du service estompe-api)
API_PUBLIC_URL=https://chat.plbls.fr

POSTGRES_PASSWORD=changer

# Gateway d'authentification (GET /auth/me) et origines des fronts (CORS, CSRF, WebSocket), séparées par des virgules.
# Ajouter l'origine de l'app Windows (Tauri, schéma https) : https://tauri.localhost
GATEWAY_URL=https://security.plbls.fr
ALLOWED_ORIGINS=https://estompe.plbls.fr,https://tauri.localhost

# Accès à Estompe : permission.plbls.fr (POST /v1/check). PERMISSION_TOKEN est le Bearer de service d'Estompe,
# à déclarer aussi dans PERMISSION__SERVICES__TOKENS côté permission. Les accès se gèrent dans l'interface de permission.
PERMISSION_URL=https://permission.plbls.fr
PERMISSION_TOKEN=changer
PERMISSION_NAME=estompe:access

# Stockage des fichiers sur le disque du VPS (volume estompe-data) : au-delà, les envois sont refusés (aucun fichier n'est supprimé). Quota par utilisateur en Mo.
MAX_STORAGE_GB=20
MAX_USER_STORAGE_MB=2048
# Taille maximale d'une vidéo (replay Bobyn), distincte des 10 Mo des pièces jointes ; elle compte dans les quotas ci-dessus.
MAX_VIDEO_SIZE_MB=100

# LIVEKIT_URL : URL publique (wss://) vue par les clients. Le secret fait au moins 32 caractères.
LIVEKIT_URL=wss://voice.plbls.fr
LIVEKIT_API_KEY=estompe
LIVEKIT_API_SECRET=changer-au-moins-32-caracteres-aleatoires
# v1 : caméra et partage d'écran
LIVEKIT_ALLOW_VIDEO=true
# Plafonds du partage d'écran annoncés aux clients (défaut 60 images/s, 2160 px de haut) ; les clients réduisent leur choix.
# VOICE_MAX_SCREEN_FPS=60
# VOICE_MAX_SCREEN_HEIGHT=2160

# Notifications push (facultatif) : générer les clés une fois avec « docker run --rm <image estompe-api> vapid »
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@plbls.fr
# Push vers l'app Android (facultatif) : JSON du compte de service Firebase (console Firebase › Paramètres › Comptes de service › Générer une clé) encodé en base64 : base64 -w0 cle.json
FCM_SERVICE_ACCOUNT=

# Blocs du backend : tous actifs par défaut ; BLOCK_<NOM>=false désactive un bloc (ses routes n'existent plus).
# Un bloc actif dont une dépendance est désactivée fait échouer le démarrage avec un message clair.
BLOCK_GIFS=true
BLOCK_MUSIQUE=true
BLOCK_VOCAL=true
BLOCK_REGARDER_ENSEMBLE=true
BLOCK_DRAW2GETHER=true
BLOCK_TRANSCRIPTION=true
BLOCK_VIDEOS=true
BLOCK_APERCU_LIENS=true
BLOCK_NOTIFICATIONS=true
BLOCK_EMOJIS=true
BLOCK_AVATARS=true
BLOCK_BADGES=true
BLOCK_SIGNALEMENTS=true
BLOCK_ACTIVITE_STATUT=true
# regarder-ensemble, draw2gether et transcription dépendent de vocal.

# Recherche de GIF (facultatif) : clé API Giphy
GIPHY_API_KEY=

# Music2gether (facultatif) : clé API YouTube Data v3 (métadonnées, albums et playlists). Sans elle : morceaux seuls, titre par oEmbed.
YOUTUBE_API_KEY=

# Transcription des messages vocaux (facultatif) : le service « transcribe » du compose (speaches, faster-whisper sur CPU) ; le modèle est
# téléchargé au premier usage. TRANSCRIBE_URL vide = transcription désactivée. Langue vide = détection automatique (ex. fr).
TRANSCRIBE_URL=http://transcribe:8000
TRANSCRIBE_MODEL=Systran/faster-whisper-small
TRANSCRIBE_LANGUAGE=
# true (défaut) : fonction alpha, visible seulement avec les fonctions alpha débloquées ; false : ouverte à tous (redémarrer l'API suffit).
TRANSCRIBE_ALPHA=true

# Supervision (facultatif) : Bearer de GET /metrics (format Prometheus) ; vide = route désactivée. Voir deploy/MONITORING.md
METRICS_TOKEN=

# Sauvegarde quotidienne de la base (voir deploy/BACKUP.md)
BACKUP_HOUR=03
BACKUP_KEEP=14
BACKUP_FILES=false

# Films et séries (facultatif, inactif par défaut) : voir deploy/JELLYFIN.md. Le bloc ne s'active qu'avec BLOCK_FILMS=true,
# JELLYFIN_URL et JELLYFIN_API_KEY ; il exige aussi vocal et regarder-ensemble. STREAM_SECRET : 32 caractères au moins (openssl rand -hex 32).
# Accès réservé à la permission estompe:movies (à créer dans permission.plbls.fr).
BLOCK_FILMS=false
JELLYFIN_NETWORK=
JELLYFIN_URL=
JELLYFIN_API_KEY=
STREAM_SECRET=
FILMS_MAX_FLUX=2
FILMS_MAX_TRANSCODAGES=2
FILMS_CACHE_SECONDES=60
