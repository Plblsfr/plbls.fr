# Estompe (estompe-api, estompe-web, livekit). Secrets : secret/estompe de Vault. Valeurs non secrètes : plbls.env ;
# communes (base, Redis, push) : deploy/.env.example. Seul estompe-api lit tout le .env ; livekit ne reçoit que LIVEKIT_API_SECRET.
# Domaines Dokploy : estompe-web port 8080 (estompe.plbls.fr), estompe-api port 8080 (chat.plbls.fr), livekit port 7880 (voice.plbls.fr).
# Ports à ouvrir sur le VPS : 7881/tcp et 50000-50100/udp (WebRTC).

# Jeton « estompe » chez aegis (AEGIS_URL de plbls.env), lu aussi par aegis
AEGIS_TOKEN_ESTOMPE=${{vault.plbls.estompe:AEGIS_TOKEN_ESTOMPE}}

# Secret de l'API LiveKit, 32 caractères au moins (clé : LIVEKIT_API_KEY de plbls.env)
LIVEKIT_API_SECRET=${{vault.plbls.estompe:LIVEKIT_API_SECRET}}

# Secrets facultatifs ci-dessous : vides = fonction coupée. Pour en activer un, mettre sa référence Vault, comme pour AEGIS_TOKEN_ESTOMPE
# (une référence vers un champ absent de Vault fait échouer le déploiement).

# GIF (Giphy) et Music2gether (YouTube Data v3) ; vides = recherche de GIF coupée, morceaux seuls sans albums ni playlists
GIPHY_API_KEY=
YOUTUBE_API_KEY=

# Supervision : Bearer de GET /metrics (format Prometheus) ; vide = route coupée (docs/estompe/MONITORING.md)
METRICS_TOKEN=
