# Copier en .env (jamais commité)
# URL PUBLIQUE du realm : doit être exactement l'`iss` des tokens (= KC_HOSTNAME côté Keycloak)
GATEWAY__OIDC__ISSUER=https://<keycloak-public>/realms/<realm>
# Même realm via le réseau Docker, pour les appels du gateway vers Keycloak (évite Cloudflare). Vide = URL publique.
GATEWAY__OIDC__INTERNAL_ISSUER=http://keycloak:8080/realms/<realm>
GATEWAY__OIDC__CLIENT_SECRET=
# Secret HMAC des en-têtes d'identité, partagé avec les micro-services (ex. openssl rand -base64 32)
GATEWAY__IDENTITY__SECRET=
# Token Bearer des routes /internal/* (GET /internal/users), vide = désactivé ; /internal ne doit pas être exposé par le proxy public
GATEWAY__INTERNAL__TOKEN=
# Plafond de `max` sur /internal/users (défaut 100)
#GATEWAY__INTERNAL__MAX_PAGE_SIZE=100
RUST_LOG=info
