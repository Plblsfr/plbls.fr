# security (auth-gateway) : secret Vault plbls/security, rendu en ${PLBLS_ENV_DIR}/security/.env
# Valeurs par défaut et réglages non secrets : api/security/config/default.toml (toute clé surchargeable en GATEWAY__<SECTION>__<CLE>).

# Fixes en production : routes embarquées dans l'image, Redis du compose
GATEWAY_CONFIG=/app/config/routes
GATEWAY__REDIS__URL=redis://security-redis:6379

# URL publique du realm, exactement l'`iss` des tokens (= KC_HOSTNAME de Keycloak)
GATEWAY__OIDC__ISSUER=https://auth.plbls.fr/realms/default
# Même realm par le réseau Docker, pour les appels serveur à serveur ; vide = URL publique
GATEWAY__OIDC__INTERNAL_ISSUER=http://keycloak:8080/realms/default
GATEWAY__OIDC__CLIENT_SECRET=changer

# Secret HMAC des en-têtes d'identité, le même chez permission, aegis (openssl rand -base64 32)
GATEWAY__IDENTITY__SECRET=changer

# Bearer des routes /internal/* (recherche de comptes pour permission et aegis) ; vide = désactivées
GATEWAY__INTERNAL__TOKEN=changer
# Plafond de `max` sur /internal/users
GATEWAY__INTERNAL__MAX_PAGE_SIZE=100

RUST_LOG=info
