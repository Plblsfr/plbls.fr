# security (auth-gateway). Secrets : secret/security de Vault. Défauts : api/security/config/default.toml (GATEWAY__<SECTION>__<CLE>).

# Fixe en production : routes embarquées dans l'image
GATEWAY_CONFIG=/app/config/routes

# Redis des sessions (service security-redis, réseau interne joint par le seul auth-gateway) : mot de passe imposé au serveur
# (openssl rand -hex 32), puis l'URL qui le contient : redis://:<SECURITY_REDIS_PASSWORD>@security-redis:6379
SECURITY_REDIS_PASSWORD=${{vault.plbls.security:SECURITY_REDIS_PASSWORD}}
GATEWAY__REDIS__URL=${{vault.plbls.security:GATEWAY__REDIS__URL}}

# URL publique du realm, exactement l'`iss` des tokens (= KC_HOSTNAME de Keycloak), puis le même realm par le réseau Docker
GATEWAY__OIDC__ISSUER=https://auth.plbls.fr/realms/default
GATEWAY__OIDC__INTERNAL_ISSUER=http://keycloak:8080/realms/default
GATEWAY__OIDC__CLIENT_SECRET=${{vault.plbls.security:GATEWAY__OIDC__CLIENT_SECRET}}

# Secret HMAC des en-têtes d'identité, repris par permission et aegis (openssl rand -hex 32)
GATEWAY__IDENTITY__SECRET=${{vault.plbls.security:GATEWAY__IDENTITY__SECRET}}

# Bearer des routes /internal/* (recherche de comptes pour permission et aegis), repris par eux
GATEWAY__INTERNAL__TOKEN=${{vault.plbls.security:GATEWAY__INTERNAL__TOKEN}}
GATEWAY__INTERNAL__MAX_PAGE_SIZE=100
