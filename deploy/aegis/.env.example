# aegis : secret Vault plbls/aegis, rendu en ${PLBLS_ENV_DIR}/aegis/.env
# Valeurs par défaut : api/aegis/config/default.toml (toute clé surchargeable en AEGIS__<SECTION>__<CLE>). Intégration : docs/aegis/integration.md.

# Postgres partagé (plbls.fr-infra, réseau postgres-net) : base et utilisateur créés avant
AEGIS__DATABASE__URL=postgres://aegis:changer@postgres-main:5432/aegis

# Même valeur que GATEWAY__IDENTITY__SECRET
AEGIS__IDENTITY__SECRET=changer

# Redis du compose : cache et canal d'invalidation auxquels Estompe et pli s'abonnent
AEGIS__REDIS__URL=redis://aegis-redis:6379
AEGIS__REDIS__PREFIX=aegis

# Jetons des services clients : nom:jeton,nom2:jeton2 (AEGIS_TOKEN d'Estompe et de pli)
AEGIS__SERVICES__TOKENS=estompe:changer,pli:changer

# Rôle Keycloak qui ouvre l'administration
AEGIS__SERVER__ADMIN_ROLE=aegis-admin

# Annuaire des comptes (route interne du gateway) ; vides = désactivé
AEGIS__GATEWAY__URL=http://auth-gateway:8080
# Même valeur que GATEWAY__INTERNAL__TOKEN
AEGIS__GATEWAY__INTERNAL_TOKEN=changer

# Hôtes que aegis peut appeler pour lister les ressources des services, séparés par des virgules
AEGIS__RESSOURCES__ALLOWED_HOSTS=estompe-api

RUST_LOG=info
