# aegis. Secrets : secret/aegis de Vault. Défauts : api/aegis/config/default.toml (AEGIS__<SECTION>__<CLE>). Intégration : docs/aegis/integration.md.

# Postgres partagé (plbls.fr-infra, réseau postgres-net), base et utilisateur créés avant : postgres://aegis:<mot de passe>@postgres-main:5432/aegis
AEGIS__DATABASE__URL=${{vault.plbls.aegis:AEGIS__DATABASE__URL}}

AEGIS__IDENTITY__SECRET=${{vault.plbls.security:GATEWAY__IDENTITY__SECRET}}

# Redis de la stack : cache et canal d'invalidation auxquels Estompe et pli s'abonnent
AEGIS__REDIS__URL=redis://aegis-redis:6379
AEGIS__REDIS__PREFIX=aegis

# Jetons des services clients : estompe:<AEGIS_TOKEN d'Estompe>,pli:<PLI_AEGIS_TOKEN>
AEGIS__SERVICES__TOKENS=${{vault.plbls.aegis:AEGIS__SERVICES__TOKENS}}

# Rôle Keycloak qui ouvre l'administration
AEGIS__SERVER__ADMIN_ROLE=aegis-admin

# Annuaire des comptes (route interne du gateway)
AEGIS__GATEWAY__URL=http://auth-gateway:8080
AEGIS__GATEWAY__INTERNAL_TOKEN=${{vault.plbls.security:GATEWAY__INTERNAL__TOKEN}}

# Hôtes que aegis peut appeler pour lister les ressources des services, séparés par des virgules.
# Vide = aucun : un manifeste qui déclare un list_url est refusé (400) et le sélecteur de ressources reste vide.
AEGIS__RESSOURCES__ALLOWED_HOSTS=estompe-api
