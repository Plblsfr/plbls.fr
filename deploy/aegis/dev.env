# Variables du backend en dev : set -a; . deploy/aegis/dev.env; set +a
AEGIS__DATABASE__URL=postgres://aegis:aegis@127.0.0.1:5434/aegis
AEGIS__REDIS__URL=redis://127.0.0.1:6380
AEGIS__IDENTITY__SECRET=dev-identity-secret
AEGIS__MCP__TOKEN=dev-mcp-token
AEGIS__SERVICES__TOKENS=estompe:dev-estompe-token,pli:dev-pli-token
AEGIS__SERVER__BIND=127.0.0.1:8091
RUST_LOG=info
