# pli : secret Vault plbls/pli, rendu en ${PLBLS_ENV_DIR}/pli/.env

# Postgres partagé (plbls.fr-infra, réseau postgres-net) : base et utilisateur créés avant
DATABASE_URL=postgres://pli:changer@postgres-main:5432/pli

# Gateway : adresse publique pour la connexion, adresse interne pour /auth/me (défaut : GATEWAY_URL)
GATEWAY_URL=https://security.plbls.fr
GATEWAY_INTERNAL_URL=http://auth-gateway:8080

# Droits par permission (jeton « pli » de PERMISSION__SERVICES__TOKENS), ou par aegis dès que AEGIS_URL et AEGIS_TOKEN sont renseignés
# (ex. http://aegis:8080, jeton « pli » de AEGIS__SERVICES__TOKENS)
PERMISSION_URL=http://permission:8080
PERMISSION_SERVICE_TOKEN=changer
AEGIS_URL=
AEGIS_TOKEN=
# Permission exigée pour déposer
DEPOSIT_PERMISSION=pli:deposit

# Taille maximale du chiffré en octets (25 Mo) et partages en attente par compte
MAX_BYTES=26214400
MAX_PENDING_PER_USER=50
