# pli. Secrets : secret/pli de Vault. Valeurs non secrètes : plbls.env ; communes (base, gateway) : deploy/.env.example.

# Jeton « pli » chez permission (PERMISSION_URL) ; avec aegis (AEGIS_URL de plbls.env), jeton « pli » chez aegis
PERMISSION_TOKEN_PLI=${{vault.plbls.pli:PERMISSION_TOKEN_PLI}}
AEGIS_TOKEN_PLI=
