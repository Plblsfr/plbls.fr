# pli. Secrets : secret/pli de Vault. GATEWAY_URL et AEGIS_URL : deploy/.env.example.

# Postgres partagé (plbls.fr-infra, réseau postgres-net), base et utilisateur créés avant : postgres://pli:<mot de passe>@postgres-main:5432/pli
PLI_DATABASE_URL=${{vault.plbls.pli:PLI_DATABASE_URL}}

# Adresse du gateway utilisée par le serveur pour /auth/me
GATEWAY_INTERNAL_URL=http://auth-gateway:8080

# Jeton « pli » déclaré dans aegis (AEGIS__SERVICES__TOKENS) ; sans lui ou sans AEGIS_URL, le dépôt répond 503
PLI_AEGIS_TOKEN=${{vault.plbls.pli:PLI_AEGIS_TOKEN}}
# Permission exigée pour déposer
DEPOSIT_PERMISSION=pli:deposit

# Taille maximale du chiffré en octets (25 Mo) et partages en attente par compte
MAX_BYTES=26214400
MAX_PENDING_PER_USER=50
