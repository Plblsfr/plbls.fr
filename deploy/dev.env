# Variables des backends en dev, valeurs factices (la production lit Vault) : set -a; . deploy/dev.env; set +a
# Services joints : ceux de deploy/docker-compose.dev.yml (Postgres :5432, Redis :6379, Keycloak :8180).
RUST_LOG=info,auth_gateway=debug

GATEWAY_CONFIG=config/dev.toml
GATEWAY__OIDC__ISSUER=http://localhost:8180/realms/plbls
GATEWAY__OIDC__INTERNAL_ISSUER=http://127.0.0.1:8180/realms/plbls
GATEWAY__OIDC__CLIENT_SECRET=dev-secret
GATEWAY__IDENTITY__SECRET=dev-identity-secret
GATEWAY__INTERNAL__TOKEN=dev-internal-token

PERMISSION__DATABASE__URL=postgres://permission:permission@127.0.0.1:5432/permission
PERMISSION__IDENTITY__SECRET=dev-identity-secret
PERMISSION__SERVICES__TOKENS=chat:dev-chat-token
PERMISSION__SERVER__BIND=127.0.0.1:8090
PERMISSION__SERVER__STATIC_DIR=

AEGIS__DATABASE__URL=postgres://aegis:aegis@127.0.0.1:5432/aegis
AEGIS__REDIS__URL=redis://127.0.0.1:6379
AEGIS__IDENTITY__SECRET=dev-identity-secret
AEGIS__SERVICES__TOKENS=estompe:dev-estompe-token,pli:dev-pli-token,entracte:dev-entracte-token
AEGIS__SERVER__BIND=127.0.0.1:8091
AEGIS__RESSOURCES__ALLOWED_HOSTS=estompe-api,127.0.0.1,localhost

ENTRACTE_DATABASE_URL=postgres://entracte:entracte@127.0.0.1:5432/entracte
ENTRACTE_PORT=8092
ENTRACTE_GATEWAY_INTERNAL_URL=http://127.0.0.1:8080
ENTRACTE_AEGIS_TOKEN=dev-entracte-token
ENTRACTE_ALLOWED_ORIGINS=http://localhost:5173
ENTRACTE_TRANSCODE_DIR=/tmp/entracte-dev
ENTRACTE_SERVICE_TOKEN=dev-entracte-service-token
