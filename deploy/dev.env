# Variables des backends en dev, valeurs factices (la production lit plbls.env et Vault) : set -a; . deploy/dev.env; set +a
# Services joints : ceux de deploy/docker-compose.dev.yml (Postgres :5432, Redis :6379, Keycloak :8180).
RUST_LOG=info,auth_gateway=debug

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432
REDIS_URL=redis://127.0.0.1:6379
GATEWAY_IDENTITE_SECRET=dev-identity-secret
GATEWAY_INTERNE_URL=http://127.0.0.1:8080
GATEWAY_INTERNE_TOKEN=dev-internal-token
AEGIS_TOKEN_ESTOMPE=dev-estompe-token
AEGIS_TOKEN_ENTRACTE=dev-entracte-token
AEGIS_TOKEN_SILLON=dev-sillon-token
AEGIS_TOKEN_REGIE=dev-regie-token

GATEWAY_CONFIG=config/dev.toml
GATEWAY__OIDC__ISSUER=http://localhost:8180/realms/plbls
GATEWAY__OIDC__INTERNAL_ISSUER=http://127.0.0.1:8180/realms/plbls
GATEWAY__OIDC__CLIENT_SECRET=dev-secret

AEGIS__SERVER__BIND=127.0.0.1:8091
AEGIS__RESSOURCES__ALLOWED_HOSTS=estompe-api,127.0.0.1,localhost

ENTRACTE_PORT=8092
ENTRACTE_ALLOWED_ORIGINS=http://localhost:5173
ENTRACTE_TRANSCODE_DIR=/tmp/entracte-dev
ENTRACTE_SERVICE_TOKEN=dev-entracte-service-token

SILLON_PORT=8093
SILLON_ALLOWED_ORIGINS=http://localhost:5173
SILLON_LIDARR_URL=http://127.0.0.1:8686
SILLON_LIDARR_CLE=dev-lidarr-key
SILLON_WEBHOOK_TOKEN=dev-sillon-webhook-token
SILLON_MEDIAS=/tmp/sillon-musique
SILLON_CACHE=/tmp/sillon-cache-dev
SILLON_MEDIAS_GO=50
SILLON_LISTENBRAINZ_URL=off
SILLON_SERVICE_TOKEN=dev-sillon-service-token
SILLON_INTERNE_URL=http://127.0.0.1:8093

REGIE_PORT=8094
REGIE_ALLOWED_ORIGINS=http://localhost:5173
REGIE_RADARR_URL=http://127.0.0.1:7878
REGIE_RADARR_CLE=dev-radarr-key
REGIE_SONARR_URL=http://127.0.0.1:8989
REGIE_SONARR_CLE=dev-sonarr-key
REGIE_LIDARR_URL=http://127.0.0.1:8686
REGIE_LIDARR_CLE=dev-lidarr-key
REGIE_PROWLARR_URL=http://127.0.0.1:9696
REGIE_PROWLARR_CLE=dev-prowlarr-key
REGIE_QBITTORRENT_URL=http://127.0.0.1:8085
REGIE_QBITTORRENT_UTILISATEUR=admin
REGIE_QBITTORRENT_MOT_DE_PASSE=adminadmin
