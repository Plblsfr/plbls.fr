# Onglet Environment de la stack Dokploy (deploy/docker-compose.yml) : ce fichier, puis le .env.example de chaque projet.
# Dokploy l'écrit dans .env au déploiement, en remplaçant chaque référence Vault (vault.plbls.<projet>:<CLE>, entre dollar-accolades doubles) par le champ <CLE> du secret
# secret/<projet> de Vault (fournisseur « plbls », Settings › Secrets). Tous les services chargent ce fichier en entier.
# Pas de « $ » dans les secrets : Compose l'interpréterait. Changer un secret dans Vault = redéployer la stack.

# Tags des images publiées par la CI : latest, X.Y.Z pour figer une version, edge pour main, beta pour le front d'une PR
GATEWAY_TAG=latest
AEGIS_TAG=latest
PLI_TAG=latest
ESTOMPE_TAG=latest
ESTOMPE_WEB_TAG=latest
CDN_TAG=latest

# Réseau Docker externe partagé avec Jellyfin (films d'Estompe) ; par défaut celui de Dokploy, qui existe toujours
JELLYFIN_NETWORK=dokploy-network

# Communes à plusieurs projets
RUST_LOG=info
# Gateway public (connexion, GET /auth/me) pour Estompe et pli
GATEWAY_URL=https://security.plbls.fr
# Service de droits d'Estompe et de pli
AEGIS_URL=http://aegis:8080
