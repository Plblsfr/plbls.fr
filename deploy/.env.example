# Onglet Environment de la stack Dokploy (deploy/docker-compose.yml) : ce fichier, puis le .env.example de chaque projet.
# Il ne contient que les secrets, les tags d'images et le réseau média : les valeurs non secrètes sont dans plbls.env (racine du dépôt),
# copié dans chaque image au build ; une variable écrite ici l'emporte sur plbls.env (RUST_LOG=debug, par exemple).
# Dokploy l'écrit dans .env au déploiement, en remplaçant chaque référence Vault (vault.plbls.<secret>:<CLE>, entre dollar-accolades doubles)
# par le champ <CLE> du secret secret/<secret> de Vault (fournisseur « plbls », Settings › Secrets) ; le champ porte le nom de la variable.
# Pas de « $ » dans les secrets : Compose l'interpréterait. Changer un secret dans Vault = redéployer la stack.

# Tags des images publiées par la CI : latest, X.Y.Z pour figer une version, edge pour main, beta pour le front d'une PR
GATEWAY_TAG=latest
PERMISSION_TAG=latest
AEGIS_TAG=latest
PLI_TAG=latest
ESTOMPE_TAG=latest
ESTOMPE_WEB_TAG=latest
CDN_TAG=latest
ENTRACTE_TAG=latest

# Réseau Docker externe de la stack média (Radarr, Sonarr) joint par Entracte. Obligatoire, sans défaut :
# le nom du réseau de la stack média de plbls.fr-infra, jamais dokploy-network, partagé par toutes les apps Dokploy
MEDIAS_NETWORK=

# Secrets communs (secret/commun de Vault), openssl rand -hex 32 pour les générer
# Mot de passe de DATABASE_USER (plbls.env) sur postgres-main, le même pour toutes les bases
DATABASE_PASSWORD=${{vault.plbls.commun:DATABASE_PASSWORD}}
# Mot de passe du Redis partagé, imposé au serveur (service redis) et ajouté à REDIS_URL par chaque client
REDIS_PASSWORD=${{vault.plbls.commun:REDIS_PASSWORD}}
# Secret HMAC des en-têtes d'identité signés par le gateway et vérifiés par permission et aegis
GATEWAY_IDENTITE_SECRET=${{vault.plbls.commun:GATEWAY_IDENTITE_SECRET}}
# Bearer des routes /internal/* du gateway (recherche de comptes pour permission et aegis)
GATEWAY_INTERNE_TOKEN=${{vault.plbls.commun:GATEWAY_INTERNE_TOKEN}}
# Notifications push d'Estompe et d'Entracte (facultatif, vides = coupées) : clés VAPID générées une fois par
# « docker run --rm ghcr.io/plblsfr/estompe vapid » ; FCM_SERVICE_ACCOUNT = JSON du compte de service Firebase en base64 (app Android)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
FCM_SERVICE_ACCOUNT=
