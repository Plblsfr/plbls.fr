# Onglet Environment de la stack Dokploy (deploy/docker-compose.yml) : ce fichier, puis le .env.example de chaque projet.
# Dokploy l'écrit dans .env au déploiement, en remplaçant chaque référence Vault (vault.plbls.<projet>:<CLE>, entre dollar-accolades doubles) par le champ <CLE> du secret
# secret/<projet> de Vault (fournisseur « plbls », Settings › Secrets). Les backends Rust chargent ce fichier en entier, les autres
# services ne reçoivent que leurs variables (environment du compose).
# Pas de « $ » dans les secrets : Compose l'interpréterait. Changer un secret dans Vault = redéployer la stack.

# Tags des images publiées par la CI : latest, X.Y.Z pour figer une version, edge pour main, beta pour le front d'une PR
GATEWAY_TAG=latest
PERMISSION_TAG=latest
AEGIS_TAG=latest
PLI_TAG=latest
ESTOMPE_TAG=latest
ESTOMPE_WEB_TAG=latest
CDN_TAG=latest
ENTRACTE_TAG=latest

# Réseau Docker externe de la stack média (Jellyfin, Radarr, Sonarr) : films d'Estompe et Entracte. Obligatoire, sans défaut :
# le nom du réseau de la stack média de plbls.fr-infra (ex. estompe-jellyfin), jamais dokploy-network, partagé par toutes les apps Dokploy
JELLYFIN_NETWORK=

# Communes à plusieurs projets
RUST_LOG=info
# Gateway public (connexion, GET /auth/me) pour Estompe, pli et Entracte
GATEWAY_URL=https://security.plbls.fr
# Service de droits pour Estompe et pli : permission, ou aegis dès que AEGIS_URL est renseignée (ex. http://aegis:8080) ; Entracte n'utilise qu'aegis
PERMISSION_URL=http://permission:8080
AEGIS_URL=
