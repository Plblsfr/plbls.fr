# Variables du compose de production (deploy/docker-compose.yml), à côté de lui en .env (ou onglet Environment de Dokploy).
# Aucun secret ici : les variables des services sont dans ${PLBLS_ENV_DIR}/<projet>/.env, rendus depuis Vault.

# Dossier des .env par projet, écrit par l'agent Vault de plbls.fr-infra (infra/vault)
PLBLS_ENV_DIR=/opt/plbls/env

# Tags des images publiées par la CI : latest, X.Y.Z pour figer une version, edge pour main, beta pour le front d'une PR
GATEWAY_TAG=latest
PERMISSION_TAG=latest
AEGIS_TAG=latest
PLI_TAG=latest
ESTOMPE_TAG=latest
ESTOMPE_WEB_TAG=latest
CDN_TAG=latest

# Réseau Docker externe partagé avec Jellyfin (films d'Estompe) ; par défaut celui de Dokploy, qui existe toujours
JELLYFIN_NETWORK=dokploy-network
