# permission. Secrets : secret/permission de Vault. Défauts : api/permission/config/default.toml (PERMISSION__<SECTION>__<CLE>).

# Postgres partagé (plbls.fr-infra, réseau postgres-net), base et utilisateur créés avant :
# postgres://permission:<mot de passe>@postgres-main:5432/permission (?sslmode=require si imposé)
PERMISSION__DATABASE__URL=${{vault.plbls.permission:PERMISSION__DATABASE__URL}}

PERMISSION__IDENTITY__SECRET=${{vault.plbls.security:GATEWAY__IDENTITY__SECRET}}

# Services autorisés à lire les permissions de n'importe quel compte : estompe:<PERMISSION_TOKEN d'Estompe>,pli:<PERMISSION_SERVICE_TOKEN de pli>
PERMISSION__SERVICES__TOKENS=${{vault.plbls.permission:PERMISSION__SERVICES__TOKENS}}

# Recherche de comptes par e-mail (route interne du gateway)
PERMISSION__GATEWAY__URL=http://auth-gateway:8080
PERMISSION__GATEWAY__INTERNAL_TOKEN=${{vault.plbls.security:GATEWAY__INTERNAL__TOKEN}}
