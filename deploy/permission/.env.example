# Variables de production (à saisir dans Dokploy ; en local : copier en .env, jamais commité)
# Postgres existant : base et utilisateur créés avant (voir README)
PERMISSION__DATABASE__URL=postgres://permission:<mot-de-passe>@<hote-postgres>:5432/permission
# Même valeur que GATEWAY__IDENTITY__SECRET (security.plbls.fr)
PERMISSION__IDENTITY__SECRET=
# Micro-services autorisés à lire les permissions de n'importe quel compte : nom:token,nom2:token2 (openssl rand -base64 32)
PERMISSION__SERVICES__TOKENS=
RUST_LOG=info
# Recherche de comptes par e-mail (route interne du gateway, réseau Docker) : vides = désactivée, saisie du sub à la place
PERMISSION__GATEWAY__URL=http://gateway:8080
# Même valeur que GATEWAY__INTERNAL__TOKEN
PERMISSION__GATEWAY__INTERNAL_TOKEN=
