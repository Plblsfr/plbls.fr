# permission : secret Vault plbls/permission, rendu en ${PLBLS_ENV_DIR}/permission/.env
# Valeurs par défaut : api/permission/config/default.toml (toute clé surchargeable en PERMISSION__<SECTION>__<CLE>).

# Postgres partagé (plbls.fr-infra, réseau postgres-net) : base et utilisateur créés avant ; ?sslmode=require si imposé
PERMISSION__DATABASE__URL=postgres://permission:changer@postgres-main:5432/permission

# Même valeur que GATEWAY__IDENTITY__SECRET
PERMISSION__IDENTITY__SECRET=changer

# Micro-services autorisés à lire les permissions de n'importe quel compte : nom:jeton,nom2:jeton2 (openssl rand -base64 32)
PERMISSION__SERVICES__TOKENS=estompe:changer,pli:changer

# Recherche de comptes par e-mail (route interne du gateway) ; vides = désactivée, saisie du sub à la place
PERMISSION__GATEWAY__URL=http://auth-gateway:8080
# Même valeur que GATEWAY__INTERNAL__TOKEN
PERMISSION__GATEWAY__INTERNAL_TOKEN=changer

RUST_LOG=info
