# Entracte (entracte-api). Secrets : secret/entracte de Vault. Valeurs non secrètes : plbls.env ; communes (base, gateway, push) : deploy/.env.example.
# Domaine Dokploy : entracte-api port 8080 (entracte-api.plbls.fr). Détail : docs/entracte/README.md ; transcodage matériel : docs/entracte/transcodage.md.

# Jeton « entracte » chez aegis ; sans lui, toutes les permissions sont refusées
AEGIS_TOKEN_ENTRACTE=${{vault.plbls.entracte:AEGIS_TOKEN_ENTRACTE}}
# Signature des flux de lecture : 32 caractères au moins ; vide = clé aléatoire à chaque démarrage
ENTRACTE_STREAM_SECRET=${{vault.plbls.entracte:ENTRACTE_STREAM_SECRET}}
# Jeton du salon cinéma, lu par Entracte (route /internal) et par Estompe ; vide = route /internal coupée
ENTRACTE_SERVICE_TOKEN=${{vault.plbls.entracte:ENTRACTE_SERVICE_TOKEN}}
# Jeton des webhooks Radarr et Sonarr : mot de passe du webhook (Basic auth, nom libre), Bearer ou …?token=… ; vide = webhooks coupés
ENTRACTE_WEBHOOK_TOKEN=
ENTRACTE_RADARR_API_KEY=${{vault.plbls.entracte:ENTRACTE_RADARR_API_KEY}}
ENTRACTE_SONARR_API_KEY=${{vault.plbls.entracte:ENTRACTE_SONARR_API_KEY}}
# TMDB : clé d'API v3 ou jeton de lecture v4
ENTRACTE_TMDB_API_KEY=${{vault.plbls.entracte:ENTRACTE_TMDB_API_KEY}}
