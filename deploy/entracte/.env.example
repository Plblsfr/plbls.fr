# Entracte (entracte-api). Secrets : secret/entracte de Vault. GATEWAY_URL et AEGIS_URL : deploy/.env.example.
# Aussi passé tel quel à l'image par la CI (ci.yml, job entracte-image). Domaine Dokploy : entracte-api port 8080 (entracte-api.plbls.fr).
# Détail : docs/entracte/README.md ; transcodage matériel : docs/entracte/transcodage.md.

# Postgres partagé (plbls.fr-infra, réseau postgres-net), base et utilisateur créés avant : postgres://entracte:<mot de passe>@postgres-main:5432/entracte
ENTRACTE_DATABASE_URL=${{vault.plbls.entracte:ENTRACTE_DATABASE_URL}}
ENTRACTE_PORT=8080

# Gateway joint par le serveur pour /auth/me (vide = GATEWAY_URL)
ENTRACTE_GATEWAY_INTERNAL_URL=http://auth-gateway:8080
# Jeton « entracte » déclaré chez aegis (AEGIS__SERVICES__TOKENS) ; sans lui, toutes les permissions sont refusées
ENTRACTE_AEGIS_TOKEN=${{vault.plbls.entracte:ENTRACTE_AEGIS_TOKEN}}

# Origines des fronts (CORS, CSRF), séparées par des virgules ; https://tauri.localhost = app Windows, http://tauri.localhost = Android
ENTRACTE_ALLOWED_ORIGINS=https://estompe.plbls.fr,https://tauri.localhost,http://tauri.localhost

# Signature des flux de lecture : 32 caractères au moins (openssl rand -hex 32) ; vide = clé aléatoire à chaque démarrage
ENTRACTE_STREAM_SECRET=${{vault.plbls.entracte:ENTRACTE_STREAM_SECRET}}
# Jeton partagé avec Estompe (salon cinéma, ESTOMPE_ENTRACTE_TOKEN) ; vide = route /internal coupée
ENTRACTE_SERVICE_TOKEN=${{vault.plbls.entracte:ENTRACTE_SERVICE_TOKEN}}
# Jeton des webhooks Radarr et Sonarr (…/webhooks/radarr?token=…) ; vide = webhooks coupés, synchronisation périodique seule
ENTRACTE_WEBHOOK_TOKEN=

# Radarr et Sonarr (stack média de plbls.fr-infra) ; profil de qualité et dossier racine des demandes acceptées
# (vides = premier profil et premier dossier racine déclarés dans Radarr/Sonarr)
ENTRACTE_RADARR_URL=http://radarr:7878
ENTRACTE_RADARR_API_KEY=${{vault.plbls.entracte:ENTRACTE_RADARR_API_KEY}}
ENTRACTE_RADARR_QUALITY_PROFILE=
ENTRACTE_RADARR_ROOT_FOLDER=
ENTRACTE_SONARR_URL=http://sonarr:8989
ENTRACTE_SONARR_API_KEY=${{vault.plbls.entracte:ENTRACTE_SONARR_API_KEY}}
ENTRACTE_SONARR_QUALITY_PROFILE=
ENTRACTE_SONARR_ROOT_FOLDER=
# Dossier des médias sur l'hôte, monté en lecture seule au même chemin dans le conteneur (service entracte-api du compose)
ENTRACTE_MEDIAS=/srv/medias
# Chemins vus par Radarr/Sonarr = chemins dans ce conteneur, sauf correspondance « distant=local » séparées par des virgules
ENTRACTE_CHEMINS=
# Synchronisation périodique du catalogue en minutes (0 = webhooks et bouton d'administration seulement)
ENTRACTE_SYNC_MINUTES=15

# TMDB : clé d'API v3 ou jeton de lecture v4 ; langue des métadonnées
ENTRACTE_TMDB_API_KEY=${{vault.plbls.entracte:ENTRACTE_TMDB_API_KEY}}
ENTRACTE_TMDB_URL=https://api.themoviedb.org
ENTRACTE_TMDB_IMAGES_URL=https://image.tmdb.org
ENTRACTE_LANGUE=fr-FR

# Lecture : ffmpeg et ffprobe de l'image, dossier temporaire (volume entracte-transcodage) et sa taille maximale en Go
ENTRACTE_FFMPEG=ffmpeg
ENTRACTE_FFPROBE=ffprobe
ENTRACTE_TRANSCODE_DIR=/tmp/entracte
ENTRACTE_TRANSCODE_MAX_GO=20
# Transcodage : cpu, vaapi, qsv ou nvenc ; périphérique (vaapi, qsv). Mode inutilisable = repli sur le CPU, signalé à l'administrateur
ENTRACTE_TRANSCODE_MODE=cpu
ENTRACTE_TRANSCODE_DEVICE=/dev/dri/renderD128
# Lectures simultanées par personne, transcodages simultanés au total, inactivité avant l'arrêt d'un flux (secondes)
ENTRACTE_MAX_FLUX=2
ENTRACTE_MAX_TRANSCODAGES=2
ENTRACTE_INACTIVITE_SECONDES=300

# Notifications push : mêmes clés VAPID et même compte Firebase qu'Estompe (un navigateur n'a qu'un abonnement push par application) ;
# vides = notifications coupées (l'app Windows lit toujours GET /notifications)
ENTRACTE_VAPID_PUBLIC_KEY=
ENTRACTE_VAPID_PRIVATE_KEY=
ENTRACTE_VAPID_SUBJECT=mailto:admin@plbls.fr
ENTRACTE_FCM_SERVICE_ACCOUNT=
